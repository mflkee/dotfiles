#!/bin/bash
# vim: ft=bash
# run_onchange hash-packages: {{ list "hyprwhspr" "wtype" "ydotool" "python-soundfile" | join "\n" | sha256sum }}

{{- $has_niri := false -}}
{{- if hasKey .machines .chezmoi.hostname -}}
{{-   $has_niri = (index .machines .chezmoi.hostname).has_niri -}}
{{- end -}}
{{- if not $has_niri }}
echo "Not a desktop machine, skipping hyprwhspr setup."
exit 0
{{- end }}

set -euo pipefail

PACKAGES=(
  hyprwhspr
  wtype
  ydotool
)

# Install AUR packages via paru
MISSING=()
for pkg in "${PACKAGES[@]}"; do
  if ! pacman -Q "$pkg" &>/dev/null; then
    MISSING+=("$pkg")
  fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo "[chezmoi] Installing missing hyprwhspr packages: ${MISSING[*]}"
  paru -S --needed --noconfirm "${MISSING[@]}"
else
  echo "[chezmoi] All hyprwhspr packages are already installed."
fi

# Core Python deps of hyprwhspr (CORE_IMPORTS in lib/src/dependency_plan.py:
# sounddevice, numpy, soxr, soundfile). The app venv is created with
# --system-site-packages, so distro packages satisfy it; soundfile lives in
# [extra] as python-soundfile.
# 2026-11-03: venv без soundfile → на каждом старте в журнале
#   [ERROR] Missing Python modules: soundfile - run: hyprwhspr setup
# (озвучивалось как «opervizor ругается»). Ставим пакет, а если sudo без
# пароля недоступен (dsync post_pull, таймер) — докидываем модуль в venv
# через pip, root для этого не нужен.
HYPRWHSPR_VENV="$HOME/.local/share/hyprwhspr/venv"
if [[ -x "$HYPRWHSPR_VENV/bin/python" ]]; then
  if ! pacman -Q python-soundfile &>/dev/null && sudo -n true 2>/dev/null; then
    echo "[chezmoi] Installing python-soundfile (hyprwhspr core dep)"
    sudo pacman -S --needed --noconfirm python-soundfile
  fi

  CORE_MISSING=()
  for mod in sounddevice numpy soxr soundfile; do
    "$HYPRWHSPR_VENV/bin/python" -c "import $mod" &>/dev/null || CORE_MISSING+=("$mod")
  done

  if [[ ${#CORE_MISSING[@]} -gt 0 ]]; then
    echo "[chezmoi] hyprwhspr venv is missing modules: ${CORE_MISSING[*]} — installing into venv"
    "$HYPRWHSPR_VENV/bin/pip" install --quiet "${CORE_MISSING[@]}"
    systemctl --user restart hyprwhspr.service 2>/dev/null || true
  fi

  for mod in sounddevice numpy soxr soundfile; do
    "$HYPRWHSPR_VENV/bin/python" -c "import $mod" &>/dev/null \
      || echo "[chezmoi] WARNING: $mod still missing in hyprwhspr venv (run: hyprwhspr setup)"
  done
fi

# Setup udev rule for uinput access
UDEV_RULE='/etc/udev/rules.d/99-hyprwhspr-uinput.rules'
if [[ ! -f "$UDEV_RULE" ]]; then
  echo 'KERNEL=="uinput", MODE="0666"' | sudo tee "$UDEV_RULE" >/dev/null
  sudo udevadm control --reload-rules
  sudo udevadm trigger
  echo "[chezmoi] Udev rule created: $UDEV_RULE"
else
  echo "[chezmoi] Udev rule already exists: $UDEV_RULE"
fi

# Add user to input group if not already
if ! groups "$USER" | grep -q '\binput\b'; then
  sudo usermod -aG input "$USER"
  echo "[chezmoi] Added $USER to input group (relogin required)"
fi

# Run hyprwhspr setup only if no config exists
if [[ ! -f "$HOME/.config/hyprwhspr/config.json" ]]; then
  echo "[chezmoi] hyprwhspr config will be deployed by chezmoi, skipping setup"
fi

# Enable ydotool user service
systemctl --user enable --now ydotool.service 2>/dev/null || true
