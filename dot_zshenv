# ~/.opencode/bin must come before /usr/bin so the curl-managed opencode (self-updating via /update) wins over a pacman install
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

# Encrypted secrets — available for all zsh sessions (including non-interactive)
[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh
