#!/usr/bin/env python3
"""
awgq - Advanced WireGuard & Tailscale Manager
CLI/TUI утилита для управления VPN и маршрутизацией
"""

import argparse
import sys
import os
from pathlib import Path

# Добавляем src в путь
sys.path.insert(0, str(Path(__file__).parent / "src"))

from config_manager import ConfigManager
from vpn_manager import VPNManager
from tailscale_manager import TailscaleManager
from route_manager import RouteManager
from logger import Logger
from tui import TUI

def main():
    parser = argparse.ArgumentParser(
        description="awgq - VPN & Tailscale Manager",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  awgq on                    # Включить VPN (default config)
  awgq on --config awg1     # Включить с конфигом awg1
  awgq off                   # Выключить VPN
  awgq status                # Показать статус
  awgq tui                   # Интерактивный режим
  awgq test                  # Запустить тесты
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Команды')
    
    # on/off/restart
    on_parser = subparsers.add_parser('on', help='Включить VPN')
    on_parser.add_argument('--config', '-c', help='Имя конфига AWG (awg0, awg1)')
    
    off_parser = subparsers.add_parser('off', help='Выключить VPN')
    off_parser.add_argument('--config', '-c', help='Имя конфига AWG')
    
    restart_parser = subparsers.add_parser('restart', help='Перезапустить VPN')
    restart_parser.add_argument('--config', '-c', help='Имя конфига AWG')
    
    toggle_parser = subparsers.add_parser('toggle', help='Переключить VPN')
    toggle_parser.add_argument('--config', '-c', help='Имя конфига AWG')
    
    # status
    subparsers.add_parser('status', help='Показать статус')
    subparsers.add_parser('logs', help='Показать логи')
    
    # test
    subparsers.add_parser('test', help='Запустить автотесты')
    
    # tui
    subparsers.add_parser('tui', help='Интерактивный TUI режим')
    
    # profile
    profile_parser = subparsers.add_parser('profile', help='Управление профилями')
    profile_subparsers = profile_parser.add_subparsers(dest='profile_cmd')
    profile_subparsers.add_parser('list', help='Список профилей')
    profile_subparsers.add_parser('add', help='Добавить профиль')
    profile_subparsers.add_parser('remove', help='Удалить профиль')
    profile_subparsers.add_parser('use', help='Использовать профиль')
    
    # configs
    configs_parser = subparsers.add_parser('configs', help='Управление конфигами AWG')
    configs_subparsers = configs_parser.add_subparsers(dest='configs_cmd')
    configs_subparsers.add_parser('list', help='Список конфигов')
    configs_subparsers.add_parser('add', help='Добавить конфиг')
    configs_subparsers.add_parser('remove', help='Удалить конфиг')
    
    import_parser = configs_subparsers.add_parser('import', help='Импортировать конфиг из файла')
    import_parser.add_argument('path', help='Путь к файлу конфига')
    import_parser.add_argument('--name', '-n', help='Имя конфига (опционально)')
    
    # route
    route_parser = subparsers.add_parser('route', help='Управление маршрутами')
    route_parser.add_argument('target', nargs='?', default='100.80.114.18')
    
    # tailscale
    ts_parser = subparsers.add_parser('tailscale', help='Управление Tailscale')
    ts_parser.add_argument('ts_cmd', choices=['status', 'fix', 'unfix', 'up', 'down'])
    
    # ts-fix — короткий алиас для tailscale fix
    subparsers.add_parser('ts-fix', help='Быстрый фикс маршрутизации Tailscale (alias для tailscale fix)')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        sys.exit(1)
    
    # Инициализация
    logger = Logger()
    config = ConfigManager()
    vpn = VPNManager(logger)
    tailscale = TailscaleManager(logger)
    routes = RouteManager(logger)
    
    # Получаем профиль и конфиг
    profile_config = config.get_profile()
    vpn_config = profile_config.get("vpn", {})
    
    # Определяем какой конфиг использовать
    awg_config = args.config if hasattr(args, 'config') and args.config else None
    
    # Находим unit для systemd
    if awg_config:
        # Ищем конфиг по имени
        configs = vpn_config.get("configs", {})
        selected = configs.get(awg_config)
        if selected:
            unit = f"awg-quick@{awg_config}.service"
        else:
            print(f"Error: Config '{awg_config}' not found")
            print(f"Available configs: {list(configs.keys())}")
            sys.exit(1)
    else:
        # Default конфиг
        unit = vpn_config.get("unit", "awg-quick@wg0.service")
    
    # Выполнение команд
    if args.command == 'on':
        if vpn.start(unit):
            # Ждём пока AWG создаст правила
            import time
            time.sleep(5)
            tailscale.fix_routes()
            
    elif args.command == 'off':
        vpn.stop(unit)
        
    elif args.command == 'restart':
        vpn.restart(unit)
        # Ждём пока AWG создаст правила
        import time
        time.sleep(5)
        tailscale.fix_routes()
        
    elif args.command == 'toggle':
        vpn.toggle(unit)
        
    elif args.command == 'status':
        vpn_status = vpn.get_status(unit)
        ts_status = tailscale.status()
        
        print(f"VPN: {'ON' if vpn_status['active'] else 'OFF'}")
        print(f"  Interface: {vpn_status['interface']}")
        print(f"  IP: {vpn_status['ip'] or 'N/A'}")
        print(f"  Config: {awg_config or 'default'}")
        print(f"Tailscale: {'ON' if ts_status['active'] else 'OFF'}")
        print(f"  IP: {ts_status['ip'] or 'N/A'}")
        print(f"Profile: {config.current_profile}")
        print(f"Mode: full")
        print(f"Route to mkair-server:")
        print(routes.get_route("100.80.114.18"))
        
    elif args.command == 'logs':
        logger.show()
        
    elif args.command == 'test':
        # Запускаем автотесты
        import subprocess
        project_dir = Path(__file__).parent
        result = subprocess.run([sys.executable, "test-automation.py"], 
                              cwd=project_dir)
        sys.exit(result.returncode)
        
    elif args.command == 'tui':
        tui = TUI(vpn, tailscale, routes, config, logger)
        tui.run()
        
    elif args.command == 'profile':
        if args.profile_cmd == 'list':
            for p in config.list_profiles():
                marker = " *" if p == config.current_profile else ""
                print(f"  {p}{marker}")
        elif args.profile_cmd == 'add':
            name = input("Имя профиля: ")
            config.add_profile(name)
        elif args.profile_cmd == 'use':
            name = input("Имя профиля: ")
            config.set_profile(name)
            
    elif args.command == 'configs':
        if args.configs_cmd == 'list' or not args.configs_cmd:
            configs = config.get_configs()
            print("Available AWG configs:")
            for name, c in configs.items():
                marker = " *" if name == "awg0" else ""
                print(f"  {name}{marker} - {c.get('description', '')}")
                print(f"    File: {c.get('file', 'N/A')}")
        elif args.configs_cmd == 'add':
            name = input("Имя конфига: ")
            file_path = input("Путь к файлу: ")
            desc = input("Описание: ")
            config.add_config(name, file_path, desc)
            print(f"Config {name} added")
        elif args.configs_cmd == 'remove':
            name = input("Имя конфига для удаления: ")
            if config.remove_config(name):
                print(f"Config {name} removed")
            else:
                print(f"Config {name} not found")
        elif args.configs_cmd == 'import':
            try:
                name = config.import_config(args.path, args.name)
                print(f"Config imported as: {name}")
            except FileNotFoundError:
                print(f"Error: File not found: {args.path}")
            except PermissionError:
                print(f"Error: Permission denied. Run with sudo?")
        
    elif args.command == 'route':
        print(routes.get_route(args.target))
        
    elif args.command == 'tailscale':
        if args.ts_cmd == 'fix':
            tailscale.fix_routes()
        elif args.ts_cmd == 'unfix':
            tailscale.unfix_routes()
        elif args.ts_cmd == 'status':
            print(tailscale.status())
        elif args.ts_cmd == 'up':
            subprocess.run(["sudo", "tailscale", "up"])
        elif args.ts_cmd == 'down':
            subprocess.run(["sudo", "tailscale", "down"])
    
    elif args.command == 'ts-fix':
        tailscale.fix_routes()

if __name__ == '__main__':
    main()
