#!/bin/bash
# vim: ft=bash
# run_onchange hash-vpntel: {{ printf "%s%s%s" (include "dot_local/bin/executable_vpntel-watchdog.tmpl") (include "dot_local/bin/executable_vpntel-stop.sh.tmpl") (include "dot_local/bin/executable_vpntel-install.sh.tmpl") | sha256sum }}
{{- $m := dict }}
{{- if hasKey .machines .chezmoi.hostname }}
{{-   $m = index .machines .chezmoi.hostname }}
{{- end }}
{{- if not (index $m "has_vpntel" | default false) }}
echo "vpntel не включён для {{ .chezmoi.hostname }}, пропускаю."
exit 0
{{- end }}

set -uo pipefail

# Установка root-части vpntel (/usr/local/bin + /etc/systemd/system).
#
# Вся установка живёт в ~/.local/bin/vpntel-install.sh — обычном управляемом
# файле, который можно запустить руками: sudo ~/.local/bin/vpntel-install.sh
#
# Здесь только: есть ли sudo. В неинтерактивной dsync-сессии пароль ввести
# нельзя, поэтому просто предупреждаем и выходим с нулём — при следующем
# обычном apply (когда пароль доступен) установка доедет.

INSTALL="{{ .chezmoi.homeDir }}/.local/bin/vpntel-install.sh"

if [ ! -x "${INSTALL}" ]; then
    echo "[chezmoi] vpntel: ${INSTALL} не найден, пропускаю."
    exit 0
fi

if sudo -n true 2>/dev/null; then
    sudo "${INSTALL}"
else
    # Если всё уже стоит — не шумим.
    if cmp -s "{{ .chezmoi.homeDir }}/.local/bin/vpntel-watchdog" /usr/local/bin/vpntel-watchdog 2>/dev/null \
       && cmp -s "{{ .chezmoi.homeDir }}/.local/bin/vpntel-stop.sh" /usr/local/bin/vpntel-stop.sh 2>/dev/null; then
        exit 0
    fi
    cat <<EOF
[chezmoi] vpntel: нужен root для установки, sudo без пароля недоступен.
Выполни один раз (пароль спросится):
    sudo ${INSTALL}
EOF
fi
