#!/bin/bash
# vim: ft=bash
# run_onchange hash-vpntel: {{ printf "%s%s" (include "dot_local/bin/executable_vpntel-watchdog.tmpl") (include "dot_local/bin/executable_vpntel-stop.sh.tmpl") | sha256sum }}
{{- $m := dict }}
{{- if hasKey .machines .chezmoi.hostname }}
{{-   $m = index .machines .chezmoi.hostname }}
{{- end }}
{{- if not (index $m "has_vpntel" | default false) }}
echo "vpntel не включён для {{ .chezmoi.hostname }}, пропускаю."
exit 0
{{- end }}

set -euo pipefail

# Установка vpntel: watchdog + stop-скрипт + systemd unit.
# Root-компоненты (/usr/local/bin, /etc/systemd/system) кладём через sudo.
#
# Скрипт идемпотентен: если всё уже установлено и совпадает с эталоном — выходит
# с нулём. Если расходится, а sudo недоступен (например, в неинтерактивной
# dsync-сессии) — выходит с ошибкой, чтобы chezmoi повторил установку позже.

TARGET_VP="{{ .chezmoi.homeDir }}/.local/bin/vpntel-watchdog"
TARGET_STOP="{{ .chezmoi.homeDir }}/.local/bin/vpntel-stop.sh"
UNIT=/etc/systemd/system/vpntel.service

# --- Что нужно поставить ----------------------------------------------------
needs_install=false

if ! cmp -s "${TARGET_VP}"   /usr/local/bin/vpntel-watchdog 2>/dev/null; then needs_install=true; fi
if ! cmp -s "${TARGET_STOP}" /usr/local/bin/vpntel-stop.sh  2>/dev/null; then needs_install=true; fi
if [ ! -f "${UNIT}" ]; then needs_install=true; fi

if [ "${needs_install}" = false ]; then
    echo "[chezmoi] vpntel уже установлен и актуален."
    exit 0
fi

# --- Нужен root -------------------------------------------------------------
if ! sudo -n true 2>/dev/null; then
    cat <<'EOF'
[chezmoi] vpntel: для установки нужен root, а sudo без пароля недоступен.
Выполни один раз:
    chezmoi apply --sudo
или вручную:
    sudo install -m755 ~/.local/bin/vpntel-watchdog /usr/local/bin/vpntel-watchdog
    sudo install -m755 ~/.local/bin/vpntel-stop.sh  /usr/local/bin/vpntel-stop.sh
    sudo systemctl daemon-reload && sudo systemctl enable --now vpntel.service
EOF
    # Ненулевой код: chezmoi повторит попытку при следующем apply.
    exit 1
fi

# --- Зависимость: tun2socks -------------------------------------------------
# Ставим через paru от имени пользователя: paru отказывается работать под root.
if ! command -v tun2socks >/dev/null 2>&1 \
   && [ ! -x "{{ .chezmoi.homeDir }}/.local/bin/tun2socks" ]; then
    echo "[chezmoi] vpntel: tun2socks не найден, ставлю из AUR..."
    sudo -u "{{ .chezmoi.username }}" paru -S --needed --noconfirm tun2socks \
        || echo "[chezmoi] WARNING: не удалось поставить tun2socks"
fi

# --- Скрипты ----------------------------------------------------------------
sudo install -m 755 "${TARGET_VP}"   /usr/local/bin/vpntel-watchdog
sudo install -m 755 "${TARGET_STOP}" /usr/local/bin/vpntel-stop.sh

# --- systemd unit -----------------------------------------------------------
sudo tee "${UNIT}" >/dev/null <<'SERVICE'
[Unit]
Description=Phone VPN tunnel via tun2socks -> phone HTTP proxy (192.168.43.1:8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpntel-watchdog
ExecStopPost=/usr/local/bin/vpntel-stop.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

sudo systemctl daemon-reload
sudo systemctl enable vpntel.service >/dev/null 2>&1 || true

# Перезапускаем только если сервис уже был активен: при первой установке
# телефон может быть недоступен — это нормально, watchdog сам включит туннель,
# когда прокси появится.
if systemctl is-active --quiet vpntel.service; then
    sudo systemctl restart vpntel.service
    echo "[chezmoi] vpntel перезапущен"
else
    echo "[chezmoi] vpntel установлен и включён (запустится при загрузке)"
fi

echo "[chezmoi] vpntel setup complete"
