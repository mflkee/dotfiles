#!/bin/bash
# vim: ft=bash
# Auto-install auto-timezone script and systemd units
# Managed by chezmoi

set -euo pipefail

SCRIPT_SRC="{{ .chezmoi.homeDir }}/.local/bin/auto-timezone.sh"

# Check if we can sudo (non-interactive check)
if ! sudo -n true 2>/dev/null; then
    echo "[chezmoi] WARNING: sudo requires a TTY. To complete setup, run:"
    echo "  chezmoi apply --sudo"
    echo "Or manually:"
    echo "  sudo cp ~/.local/bin/auto-timezone.sh /usr/local/bin/"
    echo "  sudo chmod +x /usr/local/bin/auto-timezone.sh"
    echo "  sudo tee /etc/systemd/system/auto-timezone.service ... (see run_onchange script)"
    exit 0
fi

# Copy script to /usr/local/bin
if [ -f "$SCRIPT_SRC" ]; then
    sudo cp "$SCRIPT_SRC" /usr/local/bin/auto-timezone.sh
    sudo chmod +x /usr/local/bin/auto-timezone.sh
    echo "[chezmoi] Installed /usr/local/bin/auto-timezone.sh"
fi

# Install systemd units
sudo tee /etc/systemd/system/auto-timezone.service > /dev/null <<'SERVICE'
[Unit]
Description=Auto-detect and set timezone via IP geolocation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/auto-timezone.sh
User=root

[Install]
WantedBy=multi-user.target
SERVICE

sudo tee /etc/systemd/system/auto-timezone.timer > /dev/null <<'TIMER'
[Unit]
Description=Periodic timezone auto-detection
Requires=auto-timezone.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
TIMER

echo "[chezmoi] Installed systemd units"

# Enable and start
sudo systemctl daemon-reload
sudo systemctl enable --now auto-timezone.timer 2>/dev/null || true
sudo systemctl enable auto-timezone.service 2>/dev/null || true
sudo systemctl start auto-timezone.service 2>/dev/null || true

echo "[chezmoi] auto-timezone setup complete"
