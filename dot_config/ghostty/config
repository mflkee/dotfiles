# Ghostty config
# Colors are managed by Noctalia (generated file: themes/noctalia).
# IMPORTANT: do NOT set background/foreground/palette here — explicit colors
# in the config override the theme file, which is why the theme wasn't applying.

# Fonts
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

# Background transparency
background-opacity = 0.95

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Terminal padding
window-padding-x = 4
window-padding-y = 2

# Split divider
cursor-click-to-move = true

# Window settings
confirm-close-surface = false
mouse-scroll-multiplier = discrete:0.5

# Minimum contrast for readability
minimum-contrast = 1.1

# Noctalia theme (written to themes/noctalia by noctalia, ignored by chezmoi)
theme = noctalia
