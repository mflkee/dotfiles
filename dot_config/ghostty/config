# Ghostty config

# Fonts
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

# Background — матовое стекло: сквозь терминал просвечивают обои.
# Обязательно парой с глобальным blur в niri, иначе фон будет резким.
background-opacity = 0.88

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Terminal padding / заполнение окна.
# Терминал рисует только целые символы-ячейки, а окно почти никогда не делится
# на высоту ячейки нацело — остаётся полоска 4–6px (её было видно снизу).
# Решение, чтобы полноэкранный TUI (opencode) занимал окно целиком:
#   • padding-color=extend-always — дотянуть цвет крайней ячейки в остаток
#     пикселей, тогда фон TUI/статус-бара доходит до самого края окна;
#   • padding-y = 0               — убрать вертикальные поля (иначе сверху/снизу
#     снова появляются полосы);
#   • padding-x = 8               — один «пробельчик» слева/справа, чтобы промт
#     не лип к краю. Эти поля заливаются цветом соседней ячейки (extend-always),
#     поэтому выглядят как продолжение фона, а не как дырка.
# Прозрачность (background-opacity 0.88) сохраняется.
window-padding-x = 8
window-padding-y = 0
window-padding-color = extend-always
window-padding-balance = true

# Split divider
cursor-click-to-move = true

# Window settings
confirm-close-surface = false
mouse-scroll-multiplier = discrete:0.5

# Убрать GTK-тайтлбар окна (серая полоса с названием "Ghostty" сверху).
# niri сам управляет окнами, декорации браузера не нужны.
gtk-titlebar = false

# Скрыть таб-бар вкладок (never = никогда). В Ghostty 1.3.x значения "hidden" НЕТ.
# Переключение вкладок остаётся: Ctrl+Shift+T новая, Ctrl+Shift+W закрыть, Ctrl+Tab.
window-show-tab-bar = never

# Minimum contrast for readability
minimum-contrast = 1.1

# Ayu dark (base16-ayu) — палитра всей системы
theme = noctalia
