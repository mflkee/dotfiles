# Ghostty Cyberpunk Terminal Config
# Based on Noctalia Cyberpunk palette

# Fonts
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

# Cyberpunk Colors
background = #0c1017
foreground = #e0e0e0
background-opacity = 0.95

# Neon cursor
cursor-style = bar
cursor-color = #ff8800
cursor-style-blink = true
cursor-opacity = 0.9

# Selection colors
selection-background = #1a1f2e
selection-foreground = #e0e0e0

# Terminal padding
window-padding-x = 4
window-padding-y = 2

# Cyberpunk palette (16 ANSI colors)
palette = 0=#090d13
palette = 1=#d14358
palette = 2=#00a66c
palette = 3=#c4a82e
palette = 4=#5c8ac4
palette = 5=#9b6bc1
palette = 6=#45a0d6
palette = 7=#e0e0e0
palette = 8=#2a3a4e
palette = 9=#ff5577
palette = 10=#00dd88
palette = 11=#ffdd44
palette = 12=#77aaff
palette = 13=#cc88ff
palette = 14=#55ddff
palette = 15=#ffffff

# Split divider
cursor-click-to-move = true
split-divider-color = #45a0d6

# Cursor trail shader
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

# Window settings
confirm-close-surface = false
mouse-scroll-multiplier = discrete:0.5

# Minimum contrast for readability
minimum-contrast = 1.1
