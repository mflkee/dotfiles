# Ghostty main terminal config
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

background-opacity = 0.95

# Remove extra viewport padding so the terminal grid reaches the window edge.
window-padding-y = 0

confirm-close-surface = false
