# Ghostty config

# Fonts
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

# Background
# Матовое стекло: прозрачность + глобальный blur в niri.
background-opacity = 0.88

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Terminal padding
# Небольшой отступ текста от рамки (0 = промпт липнет к краю).
window-padding-x = 10
window-padding-y = 8
# Заливать поля цветом ближайшей ячейки, а не фоном темы — тогда TUI
# занимает окно целиком, без серой «пустой» рамки вокруг.
# Именно extend-always: обычный `extend` отключается, если в ближайшей строке
# есть ячейки стандартного фона — и поле снова становится серым.
window-padding-color = extend-always
# Лишние пиксели (размер окна не кратен размеру символа) распределять
# равномерно, а не сваливать полосой снизу/справа.
window-padding-balance = true

# Split divider
cursor-click-to-move = true

# Window settings
confirm-close-surface = false
mouse-scroll-multiplier = discrete:0.5

# Убрать GTK-тайтлбар окна (серая полоса с названием "Ghostty" сверху).
# niri сам управляет окнами, декорации браузера не нужны.
gtk-titlebar = false

# Скрыть таб-бар вкладок (never = никогда). В Ghostty 1.3.x значения "hidden" НЕТ.
# Переключение вкладок остаётся: Ctrl+Shift+T новая, Ctrl+Shift+W закрыть, Ctrl+Tab.
window-show-tab-bar = never

# Minimum contrast for readability
minimum-contrast = 1.1

# Ayu dark (base16-ayu) — палитра всей системы
theme = noctalia
