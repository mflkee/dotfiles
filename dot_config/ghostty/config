# Ghostty config

# Fonts
font-family = "FiraCode Nerd Font Mono"
font-family = "Iosevka Nerd Font Mono"
font-feature = "calt"
font-size = 14

# Background
background-opacity = 1.0

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Terminal padding
window-padding-x = 4
window-padding-y = 2

# Split divider
cursor-click-to-move = true

# Window settings
confirm-close-surface = false
mouse-scroll-multiplier = discrete:0.5

# Minimum contrast for readability
minimum-contrast = 1.1

# Kemuri Susu theme (smoke-gray, matches Noctalia)
theme = kemuri-susu
