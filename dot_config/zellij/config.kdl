// Zellij — замена tmux. Полностью своя раскладка (clear-defaults), чтобы
// вести себя привычно: префикс Ctrl-a, как в старом ~/.tmux.conf.
//
// Быстрый справочник (prefix = Ctrl-a):
//   prefix c        — новая вкладка (окно)
//   prefix | / %    — сплит вправо
//   prefix - / "    — сплит вниз
//   prefix h/j/k/l  — переход между панелями
//   prefix H/J/K/L  — растянуть панель влево/вниз/вверх/вправо
//   prefix z        — панель на весь экран
//   prefix x        — закрыть панель
//   prefix &        — закрыть вкладку
//   prefix ,        — переименовать вкладку
//   prefix n / p    — след./пред. вкладка
//   prefix 1..9     — вкладка по номеру
//   prefix [        — режим прокрутки/копирования (q — выход, e — редактор)
//   prefix D        — синхронный ввод во все панели
//   prefix d        — отсоединиться (сессия живёт, вернуться: zellij attach main)
//   prefix Ctrl-a   — отправить в программу настоящий Ctrl-a
//   prefix q        — закрыть Zellij целиком

// Оболочка для новых панелей.
default_shell "/bin/zsh"

// При закрытии окна терминала — отсоединиться, а не убивать сессию
// (аналог tmux detach вместо kill-server).
on_force_close "detach"

// Мышь: выделение/скролл/перетаскивание рамок. Shift временно отключает.
mouse_mode true
copy_on_select true

// История вывода на панель (как history-limit в tmux).
scroll_buffer_size 100000

// Сериализация сессий на диск: после перезапуска `zellij attach main`
// восстанавливает раскладку и содержимое панелей.
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

// Не показывать плашку с release notes при первом запуске.
show_release_notes false

// Тема Noctalia/Miasma — та же палитра, что в ghostty/foot.
theme "noctalia"

themes {
    noctalia {
        fg "#d1d1c7"
        bg "#1f2430"
        black "#171b24"
        red "#ed8274"
        green "#87d96c"
        yellow "#facc6e"
        blue "#6dcbfa"
        magenta "#dabafa"
        cyan "#90e1c6"
        white "#c7c7c7"
        orange "#edbe74"
    }
}

// ─────────────────────────────────────────────────────────────────────────
// Клавиши
// ─────────────────────────────────────────────────────────────────────────
keybinds clear-defaults=true {
    // normal — работает без префикса. Ctrl-* намеренно не перехватываем:
    // они должны доходить до программы (в nvim Ctrl-h/j/k/l двигают сплиты).
    // Для навигации по панелям Zellij использует Alt-стрелки — они доступны
    // и снаружи, и внутри nvim, и привязаны к тем же h/j/k/l.
    normal {
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }

    // locked — режим, в котором Zellij не перехватывает вообще ничего.
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // tmux — режим префикса (Ctrl-a), аналог tmux prefix.
    tmux {
        // Отправить настоящий Ctrl-a в программу.
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Вкладки (окна)
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Сплиты
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }

        // Фокус панелей
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind ";" { FocusLastPane; SwitchToMode "Normal"; }

        // Изменение размера панелей (в tmux это prefix+Ctrl-стрелки)
        bind "H" { Resize "Increase Left"; SwitchToMode "Normal"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Normal"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Normal"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Normal"; }

        // Прочее
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "D" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
        bind "r" { SwitchToMode "Resize"; }
    }

    // resize — отдельный режим для тонкой подгонки размеров.
    resize {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "+" "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // scroll — прокрутка и копирование (аналог tmux copy-mode).
    scroll {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "q" "Esc" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
    }

    search {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Scroll"; }
    }

    renametab {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Enter" { TabNameInput 0; SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }

    renamepane {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Enter" { PaneNameInput 0; SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }

    // Префикс доступен из любого режима, кроме locked и самого tmux.
    shared_except "tmux" "locked" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Ctrl q" { Quit; }
    }

    // Enter/Esc возвращает из любого модального режима в normal.
    shared_except "normal" "locked" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
}

// В фоне держим только разметку ссылок (как в дефолте).
load_plugins {
    "zellij:link"
}
