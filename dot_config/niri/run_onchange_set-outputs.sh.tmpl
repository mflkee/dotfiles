{{- $isDesktop := or (eq .chezmoi.hostname "archlinux-desktop") (eq .chezmoi.hostname "omarchy-desktop") -}}
#!/bin/sh
# Re-runs when niri config changes: {{ include "dot_config/niri/config.kdl" | sha256sum }}
# Configures output mode, scale, transform, and position per-machine.

# Write a persistent copy so dsync can re-run it even when chezmoi state is stale.
MARKER="# Generated from run_onchange_set-outputs.sh.tmpl — DO NOT EDIT"
cat > "$HOME/.config/niri/set-outputs.sh" << 'EOF'
#!/bin/sh
# $MARKER

# Find niri socket for SSH/non-interactive sessions
find_niri_socket() {
    for s in /run/user/$(id -u)/niri.*.sock; do
        [ -S "$s" ] && { echo "$s"; return 0; }
    done
    return 1
}

setup_output() {
    local name="$1" mode="$2" scale="$3" transform="$4" x="$5" y="$6"
    # Niri 26.04+ changed CLI: removed "set" subcommand for mode/scale/transform
    niri msg output "$name" mode "$mode" 2>/dev/null || true
    niri msg output "$name" scale "$scale" 2>/dev/null || true
    niri msg output "$name" transform "$transform" 2>/dev/null || true
    # Use -- so negative Y coordinates are not parsed as flags
    niri msg output "$name" position set -- "$x" "$y" 2>/dev/null || true
}

SOCK=$(find_niri_socket) && export NIRI_SOCKET="$SOCK"

if command -v niri >/dev/null 2>&1 && niri msg outputs >/dev/null 2>&1; then
{{ if $isDesktop -}}
    # Desktop (archlinux-desktop): Thunderobot F27H144F (DP-4) left, ASUS VP249 (HDMI-A-2) right
    setup_output "DP-4"    "1920x1080@165.003" 1.0 "normal"  0 0
    setup_output "HDMI-A-2" "1920x1080@144.013" 1.0 "270"   1920 -840
{{ else -}}
    # Laptop/notebook/mkair: eDP-1 left, HDMI-A-1 external right
    setup_output "eDP-1"   "1920x1080@60.004"  1.0 "normal"  0 0
    setup_output "HDMI-A-1" "1920x1080@60.000" 1.0 "normal"  1920 0
{{ end -}}
fi
EOF
chmod +x "$HOME/.config/niri/set-outputs.sh"

# Run the setup immediately
bash "$HOME/.config/niri/set-outputs.sh"
