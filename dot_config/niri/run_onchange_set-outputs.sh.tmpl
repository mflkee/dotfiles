{{- $isDesktop := or (eq .chezmoi.hostname "archlinux-desktop") (eq .chezmoi.hostname "omarchy-desktop") -}}
#!/bin/sh
# Re-runs when niri config changes: {{ include "dot_config/niri/config.kdl" | sha256sum }}
# Configures output mode, scale, transform, and position per-machine.

setup_output() {
    local name="$1" mode="$2" scale="$3" transform="$4" x="$5" y="$6"
    niri msg output "$name" mode set "$mode" 2>/dev/null || true
    niri msg output "$name" scale set "$scale" 2>/dev/null || true
    niri msg output "$name" transform set "$transform" 2>/dev/null || true
    niri msg output "$name" position set "$x" "$y" 2>/dev/null || true
}

if command -v niri >/dev/null 2>&1 && niri msg outputs >/dev/null 2>&1; then
{{ if $isDesktop -}}
    # Desktop: Thunderobot F27H144F (DP-4) left, ASUS VP249 (HDMI-A-2) right
    setup_output "DP-4"    "1920x1080@165.003" 1.0 "normal"  0 0
    setup_output "HDMI-A-2" "1920x1080@144.013" 1.0 "270"   1920 -840
{{ else -}}
    # Laptop: eDP-1 (built-in) left, HDMI-A-1 (external) right
    setup_output "eDP-1"   "1920x1080@60.004"  1.0 "normal"  0 0
    setup_output "HDMI-A-1" "1920x1080@60.000" 1.0 "normal"  1920 0
{{ end -}}
fi
