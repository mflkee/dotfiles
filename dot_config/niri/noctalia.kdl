layout {

    focus-ring {
        active-color   "#cb9168"
        inactive-color "#242120"
        urgent-color   "#c6685d"
    }

    border {
        active-color   "#cb9168"
        inactive-color "#242120"
        urgent-color   "#c6685d"
    }


    tab-indicator {
        active-color   "#cb9168"
        inactive-color "#653a1c"
        urgent-color   "#c6685d"
    }

    insert-hint {
        color "#cb916880"
    }
}

recent-windows {
    highlight {
        active-color "#cb9168"
        urgent-color "#c6685d"
    }
}
