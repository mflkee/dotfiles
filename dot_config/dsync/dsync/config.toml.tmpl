# dsync v2 (Rust) — hub-based machine state synchronizer over QUIC
# Hub: archlinux-server:42069 (systemd user unit dsync-hub.service)
# Machine names: desktop, notebook, archlinux-mkair, archlinux-server
#
[machine]
name = "{{ if eq .chezmoi.hostname "archlinux-desktop" }}desktop{{ else if eq .chezmoi.hostname "archlinux-notebook" }}notebook{{ else }}{{ .chezmoi.hostname }}{{ end }}"

[hub_connect]
address = "{{ if eq .chezmoi.hostname "archlinux-server" }}127.0.0.1{{ else }}100.89.126.211{{ end }}:42069"

[projects.dsync]
path = "/home/mflkee/projects/dsync"
branch = "main"
machines = ["notebook", "desktop", "archlinux-mkair", "archlinux-server"]
# rebuild + replace client binary after pull (hub binary is updated manually)
post_pull = "cargo build --release --quiet && cp -f target/release/dsync ~/.local/bin/dsync"

[projects.dotfiles]
path = "/home/mflkee/dotfiles"
branch = "main"
machines = ["notebook", "desktop", "archlinux-mkair", "archlinux-server"]
post_pull = "chezmoi apply --force"

# ~/projects целиком синхронизируется через Syncthing (папка "projects",
# полное зеркало, включая .git) — см. vault servers/mesh-map.md.
# Поэтому [auto_projects] и [projects.*] под ~/projects отключены.
# dsync оставлен только для dotfiles (+ состояние tmux/opencode) и самого
# репозитория dsync (сборка бинаря через post_pull; в Syncthing исключён .stignore).

# Авто-захват правок живых dotfiles при dsync push (см. AGENTS.md).
# Всё опционально; по умолчанию watch = все файлы под chezmoi (managed),
# а исключения уже встроены (шаблоны .tmpl, темы, ~/Pictures и т.п.).
# [capture]
# watch = ["~/.zshrc", "~/.config", "~/.local/bin"]
# exclude = ["~/.config/ghostty/themes"]

# Не-git состояние флота: tmux-раскладка (tmux-resurrect) и сессии opencode.
# Синхронизируется через хаб (state_push/state_pull). tmux_restore = true
# запускает resurrect restore в живом tmux после применения чужого снапшота.
[state]
tmux = true
tmux_restore = true

# Сессии opencode: по умолчанию — для всех [projects.*]. Можно ограничить:
# [state.opencode]
# projects = ["~/projects/mushroomwars"]
[state.opencode]

{{ if eq .chezmoi.hostname "archlinux-server" }}
[hub]
bind = "0.0.0.0:42069"
data_dir = "/home/mflkee/.local/share/dsync-hub"

[remote.archlinux-server]
host = "127.0.0.1"
port = 22
user = "mflkee"

[remote.notebook]
host = "100.89.198.212"
port = 22
user = "mflkee"

[remote.desktop]
host = "100.89.12.158"
port = 22
user = "mflkee"

[remote.archlinux-mkair]
host = "100.89.59.195"
port = 22
user = "mflkee"
{{ end }}