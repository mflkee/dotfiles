[Unit]
Description=rclone mount Synology NAS (webdav.mkair.ru) -> ~/nas
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/home/mflkee/.local/bin/rclone mount syno: /home/mflkee/nas --vfs-cache-mode full --vfs-cache-max-size 20G --vfs-cache-max-age 720h --dir-cache-time 24h --attr-timeout 1h --timeout 30s --contimeout 10s --low-level-retries 2 --allow-non-empty --log-file /home/mflkee/.local/state/rclone-syno.log --log-level INFO
# rclone сам снимает моунт по SIGTERM; команды `rclone unmount` в v1.74 больше нет.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
