#!/usr/bin/env bash
set -euo pipefail

NS="vpnns"
VETH_HOST="veth-vpn"
VETH_NS="veth-ns"
SUBNET="10.200.200.0/24"
HOST_IP="10.200.200.1/24"
NS_IP="10.200.200.2/24"

# подставь реальный uplink-интерфейс (у тебя чаще wlan0)
UPLINK="$(ip route show default | awk '/default/ {print $5; exit}')"

CFG="/etc/amneziawg/nl.conf"
WG_IF="nl"
EP_IP="95.211.64.41"

# cleanup старого (мягко)
ip netns del "$NS" 2>/dev/null || true
ip link del "$VETH_HOST" 2>/dev/null || true

# namespace + veth
ip netns add "$NS"
ip link add "$VETH_HOST" type veth peer name "$VETH_NS"
ip link set "$VETH_NS" netns "$NS"

ip addr add "$HOST_IP" dev "$VETH_HOST"
ip link set "$VETH_HOST" up

ip netns exec "$NS" ip link set lo up
ip netns exec "$NS" ip addr add "$NS_IP" dev "$VETH_NS"
ip netns exec "$NS" ip link set "$VETH_NS" up
ip netns exec "$NS" ip route replace default via 10.200.200.1

# форвардинг
sysctl -w net.ipv4.ip_forward=1 >/dev/null

# nft NAT (минимальный ruleset)
nft flush ruleset
nft add table inet nat
nft 'add chain inet nat postrouting { type nat hook postrouting priority srcnat; policy accept; }'
nft add rule inet nat postrouting ip saddr $SUBNET masquerade

nft add table inet filter
nft 'add chain inet filter forward { type filter hook forward priority filter; policy accept; }'

# route до endpoint НЕ через wg (чтобы рукопожатие точно шло через veth->uplink)
ip netns exec "$NS" ip route replace ${EP_IP}/32 via 10.200.200.1 dev "$VETH_NS"

# поднять AmneziaWG в netns
ip netns exec "$NS" awg-quick down "$CFG" 2>/dev/null || true
ip netns exec "$NS" awg-quick up "$CFG"

# быстрый smoke test (не падаем, просто печатаем)
ip netns exec "$NS" curl -4 --max-time 8 https://api.openai.com/v1/models -I >/dev/null 2>&1 \
  && echo "[vpnns-up] OpenAI reachable via VPN" \
  || echo "[vpnns-up] WARN: OpenAI check failed (may be temporary/CF)"
