{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "ayu"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "keybinds": {
    "session.tab.next": "ctrl+tab,alt+down,alt+l,alt+д",
    "session.tab.previous": "ctrl+shift+tab,alt+up,alt+h,alt+р"
  }
}
