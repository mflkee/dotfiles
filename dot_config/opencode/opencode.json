{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": [
    "instructions/machines.md"
  ],
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "provider": {
    "openai":     { "options": { "baseURL": "https://api.proxyapi.ru/openai/v1" } },
    "anthropic":  { "options": { "baseURL": "https://api.proxyapi.ru/anthropic/v1" } },
    "google":     { "options": { "baseURL": "https://api.proxyapi.ru/google/v1beta" } },
    "openrouter": { "options": { "baseURL": "https://api.proxyapi.ru/openrouter/v1" } }
  },
  "providers": {
    "routerai": {
      "name": "RouterAI",
      "env": ["ROUTERAI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://routerai.ru/api/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash 0731",
          "modelID": "deepseek/deepseek-v4-flash-0731",
          "cost": { "input": 4.82, "output": 12 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "modelID": "deepseek/deepseek-v4.1-flash",
          "cost": { "input": 18, "output": 72 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro 0813",
          "modelID": "deepseek/deepseek-v4-pro-0813",
          "cost": { "input": 101, "output": 303 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-chat": {
          "name": "DeepSeek V3.2",
          "modelID": "deepseek/deepseek-v3.2",
          "cost": { "input": 22, "output": 33 },
          "limit": { "context": 164000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        }
      }
    }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "obsidian-mcp", "/home/mflkee/obs_main"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "netbird": {
      "type": "local",
      "command": ["node", "/home/mflkee/.config/opencode/scripts/netbird-mcp.js"],
      "enabled": true,
      "environment": {
        "NETBIRD_API_KEY": "{env:NETBIRD_API_KEY}"
      }
    },
    "sync-ops": {
      "type": "local",
      "command": ["node", "/home/mflkee/.config/opencode/scripts/sync-ops-mcp.js"],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["uvx", "mcp-for-blender"],
      "enabled": true
    },
    "zen": {
      "type": "remote",
      "url": "http://127.0.0.1:8877/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp",
        "--cwd",
        "/home/mflkee/projects/rustrade/rustrade-dashboard/web"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
