{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "skills": ["~/.config/opencode/skills"],
  "providers": {
    "openai":     { "settings": { "baseURL": "https://api.proxyapi.ru/openai/v1" } },
    "anthropic":  { "settings": { "baseURL": "https://api.proxyapi.ru/anthropic/v1" } },
    "google":     { "settings": { "baseURL": "https://api.proxyapi.ru/google/v1beta" } },
    "openrouter": { "settings": { "baseURL": "https://api.proxyapi.ru/openrouter/v1" } },
    "routerai": {
      "name": "RouterAI",
      "env": ["ROUTERAI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://routerai.ru/api/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash 0731",
          "modelID": "deepseek/deepseek-v4-flash-0731",
          "cost": { "input": 4.82, "output": 12 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "modelID": "deepseek/deepseek-v4.1-flash",
          "cost": { "input": 18, "output": 72 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro 0813",
          "modelID": "deepseek/deepseek-v4-pro-0813",
          "cost": { "input": 101, "output": 303 },
          "limit": { "context": 1000000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        },
        "deepseek-chat": {
          "name": "DeepSeek V3.2",
          "modelID": "deepseek/deepseek-v3.2",
          "cost": { "input": 22, "output": 33 },
          "limit": { "context": 164000, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning" }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "obsidian": {
        "type": "local",
        "command": ["npx", "-y", "obsidian-mcp", "/home/mflkee/obs_main"]
      },
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "netbird": {
        "type": "local",
        "command": ["node", "/home/mflkee/.config/opencode/scripts/netbird-mcp.js"],
        "environment": {
          "NETBIRD_API_KEY": "{env:NETBIRD_API_KEY}"
        }
      },
      "sync-ops": {
        "type": "local",
        "command": ["node", "/home/mflkee/.config/opencode/scripts/sync-ops-mcp.js"]
      },
      "gmail": {
        "type": "local",
        "command": ["node", "/home/mflkee/Documents/finance_manager/mcp/gmail-mcp.js"]
      },
      "duckdb": {
        "type": "local",
        "command": [
          "uvx",
          "--with",
          "mcp==1.0.0",
          "mcp-server-duckdb",
          "--db-path",
          "/tmp/opencode/data/analysis.duckdb"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless",
          "--isolated"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "blender": {
        "type": "local",
        "command": ["uvx", "mcp-for-blender"],
        "disabled": true
      },
      "zen": {
        "type": "remote",
        "url": "http://127.0.0.1:8877/mcp",
        "disabled": true
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
        "disabled": true
      }
    }
  }
}
