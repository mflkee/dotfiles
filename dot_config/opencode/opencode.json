{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions/machines.md"
  ],
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "provider": {
    "openai":     { "options": { "baseURL": "https://api.proxyapi.ru/openai/v1" } },
    "anthropic":  { "options": { "baseURL": "https://api.proxyapi.ru/anthropic/v1" } },
    "google":     { "options": { "baseURL": "https://api.proxyapi.ru/google/v1beta" } },
    "openrouter": { "options": { "baseURL": "https://api.proxyapi.ru/openrouter/v1" } }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "obsidian-mcp", "/home/mflkee/obs_main"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "netbird": {
      "type": "local",
      "command": ["node", "~/.config/opencode/scripts/netbird-mcp.js"],
      "enabled": true,
      "environment": {
        "NETBIRD_API_KEY": "{env:NETBIRD_API_KEY}"
      }
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
