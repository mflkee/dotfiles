#!/usr/bin/env bash
set -euo pipefail

# Bootstrap dsync v2 (Rust) on a new machine.
# Requires: git, ssh, netbird, cargo (rustup), chezmoi.
# Builds the release binary from source and installs it to ~/.local/bin/dsync.

DSYNC_DIR="${DSYNC_DIR:-$HOME/projects/dsync}"
DSYNC_REPO="${DSYNC_REPO:-https://github.com/mflkee/dsync.git}"

command -v git >/dev/null 2>&1 || { echo "git is required" >&2; exit 1; }
if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo (rust) is required:" >&2
  echo '  curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh' >&2
  exit 1
fi

if [ -d "$DSYNC_DIR/.git" ]; then
  echo "Updating dsync..."
  git -C "$DSYNC_DIR" pull --ff-only
else
  echo "Cloning dsync..."
  rm -rf "$DSYNC_DIR"
  git clone "$DSYNC_REPO" "$DSYNC_DIR"
fi

echo "Building dsync..."
cargo build --release --manifest-path "$DSYNC_DIR/Cargo.toml"

mkdir -p "$HOME/.local/bin"
cp "$DSYNC_DIR/target/release/dsync" "$HOME/.local/bin/dsync"

echo "dsync installed at $HOME/.local/bin/dsync. Run 'dsync status'."
echo "Config comes from chezmoi: ~/.config/dsync/dsync/config.toml"
