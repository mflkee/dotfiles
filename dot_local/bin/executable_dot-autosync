#!/usr/bin/env bash
# dot-autosync: live-file -> chezmoi source -> git -> dsync
# Edit dotfiles directly (vim ~/.zshrc), this picks changes up automatically.
set -uo pipefail

SRC="$HOME/dotfiles"
CACHE="$HOME/.cache/dot-autosync"
STATE="$CACHE/state"
cd "$SRC" || exit 0

# Files NOT safe to auto re-add (regenerated by noctalia / templates):
# edits there go through `chezmoi edit --apply` manually instead.
EXCLUDE_RE='(^\.config/(starship\.toml)$)|(^\.config/ghostty/themes/)|(^\.config/kitty/themes/noctalia)|(\.tmpl$)'

# Whitelist: what we watch (live paths, relative to $HOME)
WATCH=(
  ".zshrc"
  ".zshenv"
  ".tmux.conf"
  ".ssh/config"
  ".config/zsh"
  ".config/ghostty/config"
  ".config/kitty/kitty.conf"
  ".config/lsd"
  ".config/htop/htoprc"
)

mkdir -p "$CACHE"
touch "$STATE"

mapfile -t files < <(
  for w in "${WATCH[@]}"; do
    p="$HOME/$w"
    if [[ -d $p ]]; then find "$p" -type f; else [[ -f $p ]] && echo "$p"; fi
  done
)

dirty=0
declare -a to_add=()
: > "$CACHE/now"
for f in "${files[@]}"; do
  h=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1) || continue
  rel=${f#"$HOME/"}
  old=$(grep -F " $rel" "$STATE" 2>/dev/null | cut -d' ' -f1)
  echo "$h $rel" >> "$CACHE/now"
  [[ $h == "$old" ]] && continue
  src=$(chezmoi source-path "$HOME/$rel" 2>/dev/null) || continue
  [[ -n $src && $src == *"$HOME"* ]] || continue
  [[ $src =~ $EXCLUDE_RE ]] && continue
  # skip nested git repos (projects/*)
  [[ -e $(dirname "$f")/.git ]] && continue
  to_add+=("$rel")
done

if ((${#to_add[@]})); then
  for rel in "${to_add[@]}"; do
    chezmoi re-add "$HOME/$rel" 2>/dev/null || echo "re-add failed: $rel" >&2
  done
  msg="dot-autosync: ${to_add[*]} ($(date '+%d.%m %H:%M'))"
  if ! git diff --quiet --cached 2>/dev/null || ! git diff --quiet; then
    git add -A && git commit -m "$msg" >/dev/null || dirty=$?
    if git push origin main >/dev/null 2>&1; then
      dsync push >/dev/null 2>&1
      echo "$(date '+%F %T') pushed: $msg" >> "$CACHE/log"
    fi
  fi
fi

mv "$CACHE/now" "$STATE"
