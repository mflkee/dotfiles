#!/bin/sh
set -e

SETTINGS="$HOME/.config/noctalia/settings.json"
[ -f "$SETTINGS" ] || exit 0

HOSTNAME=$(hostname)

case "$HOSTNAME" in
    archlinux-notebook*)
        command -v jq >/dev/null 2>&1 || exit 0
        jq '
            .networkPanelView = "ethernet" |
            .bluetoothAutoConnect = false |
            .locationName = "" |
            .bar.widgets.right = [.bar.widgets.right[] | select(.id != "plugin:arch-updater")]
        ' "$SETTINGS" > "${SETTINGS}.tmp" && mv "${SETTINGS}.tmp" "$SETTINGS"
        ;;
esac
