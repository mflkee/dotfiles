#!/usr/bin/env bash
# OpenCode Go accounts for the "OpenCode Go Usage" Noctalia widget + CLI.
#
# v2 — несколько аккаунтов (A/B …), быстрый свайп из бара и хоткеем.
#
# Каждый аккаунт = отдельный логин в opencode.ai/console (отдельный email) со
# своей подпиской OpenCode Go (~1100₽/мес). Планируется полмесяца на одном,
# полмесяца на другом; переключение занимает ~1 секунду.
#
# Хранилище (0600/0700):
#   ~/.config/opencode-go/credentials.json     copy активного аккаунта (виджет читает его)
#   ~/.config/opencode-go/current              имя активного аккаунта ("a" / "b")
#   ~/.config/opencode-go/accounts/<name>.json токен аккаунта (org_id/access_token/expires_at)
#   ~/.config/opencode-go/accounts/<name>.cli  id креда opencode CLI для аккаунта (опц.)
#
# Команды:
#   opencode-go-auth login [--account NAME]    device flow -> accounts/NAME.json
#   opencode-go-auth use NAME | toggle         переключить активный аккаунт (ручной флип)
#   opencode-go-auth rotate                    выставить аккаунт по половине месяца (идемпотентно)
#   opencode-go-auth apply [NAME]              привести ЭТУ машину к активному (файлы + CLI)
#   opencode-go-auth list                      список аккаунтов + метка + активный + срок токенов
#   opencode-go-auth label NAME TEXT|rem       человекочитаемая метка (Kimi / Mfokinors)
#   opencode-go-auth auto                      переключиться на живой аккаунт, если текущий мёртв/выбран
#   opencode-go-auth whoami [NAME]             что консоль знает о токене (email и т.п.)
#   opencode-go-auth link NAME CLI_CRED_ID     привязать аккаунт к credential opencode CLI
#   opencode-go-auth status [--json] [NAME]    лимиты Go-плана (как видит виджет)
#   opencode-go-auth check [SECONDS]           уведомить, если токен скоро истекает
#   opencode-go-auth sync                      переписать secrets.zsh из accounts/
#   opencode-go-auth logout [NAME]             удалить аккаунт
#
# use/toggle/rotate обновляют блок в secrets.zsh (без dsync push): так активный
# аккаунт и легаси-переменные доезжают до остальных машин, а `apply` после pull
# приводит их CLI к тому же аккаунту.
#
# Секреты в репо — только в зашифрованном ~/.config/zsh/secrets.zsh (chezmoi):
#   OPENCODE_GO_ORG_A/TOKEN_A/EXPIRES_A, … и легаси-переменные активного
#   (OPENCODE_GO_ORG/TOKEN/EXPIRES_AT) для старых машин.
set -euo pipefail

SERVER="${OPENCODE_GO_SERVER:-https://opencode.ai/console}"
ORIGIN="$(printf '%s' "$SERVER" | sed -E 's#^([a-z]+://[^/]+).*#\1#')"
CLIENT_ID="${OPENCODE_GO_CLIENT_ID:-opencode-cli}"
BASE="${OPENCODE_GO_BASE:-$HOME/.config/opencode-go}"
CREDS="${OPENCODE_GO_CREDS:-$BASE/credentials.json}"
ACCOUNTS_DIR="${OPENCODE_GO_ACCOUNTS:-$BASE/accounts}"
# ВНИМАНИЕ:override именно *_FILE. Имя OPENCODE_GO_CURRENT занято secrets.zsh
# и там означает ИМЯ активного аккаунта ("a"/"b"), а не путь. Когда скрипт
# брал его как путь, указатель писался в ./a (CWD), current не менялся,
# а виджет и CLI расходились: переключение «не работало».
CURRENT_FILE="${OPENCODE_GO_CURRENT_FILE:-$BASE/current}"
API="$SERVER/api/go/status"
TOKEN_URL="$SERVER/auth/device/token"
UA="opencode-go-auth/2.0 (noctalia widget)"
NOTIFY=(notify-send -a "OpenCode Go")

log()  { printf '%s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

humanize() {
  local s="${1:-0}"
  [ "$s" -lt 0 ] && s=0
  local d=$(( s / 86400 )) h=$(( s % 86400 / 3600 )) m=$(( s % 3600 / 60 ))
  if [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"
  else printf '%dm' "$m"; fi
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }
need curl
need jq

# Страховка от повторения коллизии: указатель обязан лежать внутри $BASE.
case "$CURRENT_FILE" in
  "$BASE"/*) : ;;
  *) die "OPENCODE_GO_CURRENT_FILE must be a path inside $BASE (got: $CURRENT_FILE)" ;;
esac

# ── accounts ──────────────────────────────────────────────────────────────────

mkdir -p "$BASE" "$ACCOUNTS_DIR"
chmod 700 "$BASE" "$ACCOUNTS_DIR"

valid_name() {
  case "$1" in
    '' | *[!a-z0-9]*) return 1 ;;
  esac
}

account_list() {
  for f in "$ACCOUNTS_DIR"/*.json; do
    [ -f "$f" ] || continue
    printf '%s\n' "$(basename "$f" .json)"
  done | sort
}

account_file()   { printf '%s/%s.json' "$ACCOUNTS_DIR" "$1"; }
cli_cred_file()  { printf '%s/%s.cli' "$ACCOUNTS_DIR" "$1"; }

account_field() {
  local name="$1" field="$2"
  jq -r --arg k "$field" '.[$k] // empty' "$(account_file "$name")"
}

# Человеческое имя для уведомлений: метка, иначе имя аккаунта (a/b).
account_display() {
  local name="$1" label
  label="$(account_field "$name" label 2>/dev/null || true)"
  [ -n "$label" ] && { printf '%s' "$label"; return 0; }
  printf '%s' "$name"
}

active_name() {
  [ -f "$CURRENT_FILE" ] || return 1
  local n; n="$(cat "$CURRENT_FILE" 2>/dev/null || true)"
  valid_name "$n" || return 1
  printf '%s' "$n"
}

write_account() {
  local name="$1" org="$2" access="$3" expires_at="$4" label="${5:-}" email="${6:-}"
  valid_name "$name" || die "invalid account name: '$name' (use [a-z0-9])"
  # Метка/email — не часть токена: при повторном login сохраняем то, что уже
  # было, иначе `login --account a` стирал бы имя аккаунта.
  if [ -f "$(account_file "$name")" ]; then
    [ -n "$label" ] || label="$(account_field "$name" label 2>/dev/null || true)"
    [ -n "$email" ] || email="$(account_field "$name" email 2>/dev/null || true)"
  fi
  local tmp; tmp="$(mktemp "$(account_file "$name").XXXXXX")"
  chmod 600 "$tmp"
  jq -n --arg org "$org" --arg access "$access" --argjson expires "$expires_at" \
    --arg label "$label" --arg email "$email" \
    '{org_id: $org, access_token: $access, expires_at: $expires}
     + (if $label == "" then {} else {label: $label} end)
     + (if $email == "" then {} else {email: $email} end)' >"$tmp"
  mv -f "$tmp" "$(account_file "$name")"
  chmod 600 "$(account_file "$name")"
}

# Метка аккаунта: человеческое имя (Kimi / Mfokinors). Живёт в secrets.zsh
# (OPENCODE_GO_LABEL_<NAME>), поэтому приезжает на все машины вместе с токенами.
set_label() {
  local name="$1" label="$2" f tmp
  f="$(account_file "$name")"
  [ -f "$f" ] || return 1
  case "$label" in -|rem|none) label="" ;; esac
  if [ -n "$label" ]; then
    case "$label" in *[!A-Za-z0-9_.:\ -]*) die "label: разрешены буквы, цифры, пробел и -_.:" ;; esac
  fi
  tmp="$(mktemp "$f.XXXXXX")" || return 1
  chmod 600 "$tmp"
  jq --arg l "$label" 'if $l == "" then del(.label) else .label = $l end' "$f" >"$tmp" \
    || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$f"
  chmod 600 "$f"
}

# Активный аккаунт: current-файл + копия в credentials.json (его читает виджет).
set_current() {
  local name="$1"
  valid_name "$name" || die "invalid account name: '$name'"
  [ -f "$(account_file "$name")" ] || die "no credentials for account '$name' — run: opencode-go-auth login --account $name"
  local tmp; tmp="$(mktemp "${CURRENT_FILE}.XXXXXX")"
  printf '%s\n' "$name" >"$tmp"
  mv -f "$tmp" "$CURRENT_FILE"
  chmod 600 "$CURRENT_FILE"
  cp -f "$(account_file "$name")" "$CREDS"
  chmod 600 "$CREDS"
}

# CLI-сторона: переключить активный credential интеграции opencode.
cli_switch() {
  local name="$1" cred
  cred="$(cat "$(cli_cred_file "$name")" 2>/dev/null || true)"
  [ -n "$cred" ] || return 2
  if command -v opencode >/dev/null 2>&1; then
    if opencode auth switch opencode "$cred" >/dev/null 2>&1; then
      return 0
    fi
    return 3
  fi
  return 2
}

notify() {
  local summary="$1" body="${2:-}"
  if command -v notify-send >/dev/null 2>&1; then
    "${NOTIFY[@]}" "$summary" "$body" >/dev/null 2>&1 || true
  fi
  if [ -n "$body" ]; then log "$summary: $body"; else log "$summary"; fi
}

# Попросить виджет обновиться (если ноутлишник запущен).
refresh_widget() {
  command -v noctalia >/dev/null 2>&1 || return 0
  timeout 8 noctalia msg plugin mflkee/opencode-go-usage:usage all refresh >/dev/null 2>&1 || true
}

# ── commit: применить активный аккаунт (используется и `use`, и `apply`) ──────

commit_switch() {
  local name="$1" old=""
  old="$(active_name 2>/dev/null || true)"
  set_current "$name"
  local cli_rc=0 msg=""
  cli_switch "$name" || cli_rc=$?
  if [ "$cli_rc" -eq 2 ]; then
    msg="CLI-аккаунт не привязан (opencode-go-auth link $name <cred_id>) — только виджет"
  elif [ "$cli_rc" -eq 3 ]; then
    msg="CLI-switch не удался — виджет переключён, CLI остался на прежнем"
  fi
  refresh_widget
  if [ "$name" != "$old" ]; then
    notify "OpenCode Go → $(account_display "$name")" "$msg"
  elif [ -n "$msg" ]; then
    notify "OpenCode Go: $(account_display "$name") уже активен ($(basename "$0") apply)" "$msg"
  fi
}

# ── secrets.zsh: единственное место токенов в репо (chezmoi-encrypted) ───────

SECRETS="${OPENCODE_GO_SECRETS:-$HOME/.config/zsh/secrets.zsh}"
SECRETS_BEGIN="# >>> opencode-go-auth >>>"
SECRETS_END="# <<< opencode-go-auth <<<"

sync_secrets() {
  local nopush="${1:-}"
  [ -f "$SECRETS" ] || die "$SECRETS not found (run: chezmoi apply)"

  local names; names="$(account_list)"
  [ -n "$names" ] || { sync_empty_block; return 0; }

  local lines="" name org access expires active line label up
  active="$(active_name 2>/dev/null || printf '%s' "$(printf '%s\n' "$names" | head -1)")"
  for name in $names; do
    org="$(account_field "$name" org_id)"; access="$(account_field "$name" access_token)"
    expires="$(account_field "$name" expires_at 2>/dev/null || echo 0)"
    label="$(account_field "$name" label 2>/dev/null || true)"
    [ -n "$org" ] && [ -n "$access" ] || continue
    up="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
    for value in "$org" "$access"; do
      case "$value" in *[!A-Za-z0-9_.:-]*) die "refusing to store unexpected characters" ;; esac
    done
    if [ -n "$label" ]; then
      case "$label" in *[!A-Za-z0-9_.:\ -]*) die "refusing to store suspicious label '$label'" ;; esac
    fi
    [ "${expires:-0}" -gt 0 ] 2>/dev/null || expires=0
    lines="$lines
export OPENCODE_GO_ORG_$up=\"$org\"
export OPENCODE_GO_TOKEN_$up=\"$access\"
export OPENCODE_GO_EXPIRES_$up=\"$expires\""
    [ -n "$label" ] && lines="$lines
export OPENCODE_GO_LABEL_$up=\"$label\""
  done
  [ -n "$lines" ] || { sync_empty_block; return 0; }

  local legacy_org legacy_token legacy_expires
  legacy_org="$(account_field "$active" org_id)"; legacy_token="$(account_field "$active" access_token)"
  legacy_expires="$(account_field "$active" expires_at 2>/dev/null || echo 0)"
  [ "${legacy_expires:-0}" -gt 0 ] 2>/dev/null || legacy_expires=0

  local block
  block="$(printf '%s\nexport OPENCODE_GO_CURRENT="%s"%s\nexport OPENCODE_GO_ORG="%s"\nexport OPENCODE_GO_TOKEN="%s"\nexport OPENCODE_GO_EXPIRES_AT="%s"\n%s' \
    "$SECRETS_BEGIN" "$active" "$lines" "$legacy_org" "$legacy_token" "$legacy_expires" "$SECRETS_END")"

  local tmp; tmp="$(mktemp "${SECRETS}.XXXXXX")"
  {
    if grep -qF "$SECRETS_BEGIN" "$SECRETS"; then
      awk -v begin="$SECRETS_BEGIN" -v end="$SECRETS_END" -v block="$block" '
        index($0, begin) == 1 { printf "%s\n", block; skip = 1; next }
        index($0, end) == 1   { skip = 0; next }
        skip != 1             { print }
      ' "$SECRETS"
    else
      cat "$SECRETS"
      if [ -s "$SECRETS" ]; then printf '\n'; fi
      printf '%s\n' "$block"
    fi
  } >"$tmp"
  chmod --reference="$SECRETS" "$tmp"
  mv -f "$tmp" "$SECRETS"

  if command -v chezmoi >/dev/null 2>&1; then
    chezmoi re-add "$SECRETS" >/dev/null 2>&1 \
      && log "re-encrypted $SECRETS into ~/dotfiles" \
      || log "warning: chezmoi re-add failed for $SECRETS"
  fi
  if [ "$nopush" != "nopush" ] && [ "${OPENCODE_GO_NO_PUSH:-0}" != "1" ] && command -v dsync >/dev/null 2>&1; then
    log "pushing the new token to the other machines (dsync push)"
    dsync push >/dev/null 2>&1 || log "warning: dsync push failed - run it by hand"
  fi
}

sync_empty_block() {
  local block tmp
  block="$(printf '%s\n# no credentials - run: opencode-go-auth login\n%s' "$SECRETS_BEGIN" "$SECRETS_END")"
  tmp="$(mktemp "${SECRETS}.XXXXXX")"
  {
    if grep -qF "$SECRETS_BEGIN" "$SECRETS"; then
      awk -v begin="$SECRETS_BEGIN" -v end="$SECRETS_END" -v block="$block" '
        index($0, begin) == 1 { printf "%s\n", block; skip = 1; next }
        index($0, end) == 1   { skip = 0; next }
        skip != 1             { print }
      ' "$SECRETS"
    else
      cat "$SECRETS"
      if [ -s "$SECRETS" ]; then printf '\n'; fi
      printf '%s\n' "$block"
    fi
  } >"$tmp"
  chmod --reference="$SECRETS" "$tmp"
  mv -f "$tmp" "$SECRETS"
}

# ── login: OAuth device flow ──────────────────────────────────────────────────

# Кто это: консоль отдаёт /api/user по Bearer-токену (схему не документируют,
# поэтому email/name вытаскиваются рекурсивно — первое строковое значение).
identify_account() {
  local token="$1" body email name
  body="$(curl -sS -m 10 -H "Authorization: Bearer $token" \
    -H 'Accept: application/json' -H "User-Agent: $UA" "$SERVER/api/user" 2>/dev/null || true)"
  [ -n "$body" ] || return 0
  email="$(printf '%s' "$body" | jq -r '[.. | objects | .email? | select(type == "string")] | first // empty' 2>/dev/null || true)"
  name="$(printf '%s' "$body" | jq -r '[.. | objects | .name? | select(type == "string")] | first // empty' 2>/dev/null || true)"
  printf '%s\t%s' "$email" "$name"
}

cmd_login() {
  local name="${1:-}"
  if [ -n "$name" ] && ! valid_name "$name"; then
    die "invalid account name '$name' (use [a-z0-9])"
  fi
  [ -z "$name" ] && name="a"
  [ "$(account_list | wc -l)" -eq 0 ] && name="a"

  local code user_code url interval expires_in device_code
  code="$(curl -sS -X POST "$SERVER/auth/device/code" \
    -H 'Content-Type: application/json' -H "User-Agent: $UA" \
    -d "{\"client_id\":\"$CLIENT_ID\",\"supports_org_scope\":true}")"
  device_code="$(printf '%s' "$code" | jq -r '.device_code // empty')"
  user_code="$(printf '%s' "$code" | jq -r '.user_code // empty')"
  url="$(printf '%s' "$code" | jq -r '.verification_uri_complete // empty')"
  interval="$(printf '%s' "$code" | jq -r '.interval // 5')"
  expires_in="$(printf '%s' "$code" | jq -r '.expires_in // 600')"
  [ -n "$device_code" ] || die "device code request failed: $code"

  case "$url" in /*) url="$ORIGIN$url" ;; esac

  log ""
  log "OpenCode Console authorization — аккаунт: $name"
  log "  code: $user_code"
  log "  open: $url"
  log ""
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 || true; fi

  local now deadline resp access org expires_at
  now="$(date +%s)"; deadline=$((now + expires_in - 5))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    resp="$(curl -sS -X POST "$TOKEN_URL" \
      -H 'Content-Type: application/json' -H "User-Agent: $UA" \
      -d "{\"grant_type\":\"urn:ietf:params:oauth:grant-type:device_code\",\"device_code\":\"$device_code\",\"client_id\":\"$CLIENT_ID\"}")"
    if printf '%s' "$resp" | jq -e '.access_token' >/dev/null 2>&1; then
      access="$(printf '%s' "$resp" | jq -r '.access_token')"
      org="$(printf '%s' "$resp" | jq -r '.org_id // empty')"
      expires_at=$(( $(date +%s) + $(printf '%s' "$resp" | jq -r '.expires_in // 0') ))
      [ -n "$org" ] || die "no org_id in the token response (is the account a member of a workspace?)"
      local ident email auto_label
      ident="$(identify_account "$access")"
      email="${ident%%$'\t'*}"
      [ "$email" = "$ident" ] && email=""
      write_account "$name" "$org" "$access" "$expires_at" "" "$email"
      if ! active_name >/dev/null 2>&1; then
        set_current "$name"
      fi
      log "saved $(account_file "$name")"
      log "  org: $org"
      if [ -n "$email" ]; then
        log "  account: $email"
        if [ -z "$(account_field "$name" label 2>/dev/null || true)" ]; then
          # Короткая метка из email: первые 3 буквы/цифры локальной части
          # (kimicode404@gmail.com -> kim), чтобы бар не распухал.
          auto_label="$(printf '%s' "${email%%@*}" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-3)"
          case "$auto_label" in
            ''|*[!A-Za-z0-9_.-]*) : ;;
            *) set_label "$name" "$auto_label"
               log "  label: $auto_label  (переименовать: opencode-go-auth label $name \"…\")" ;;
          esac
        fi
      fi
      log "  valid until: $(date -d "@$expires_at" '+%Y-%m-%d %H:%M')"
      sync_secrets
      refresh_widget
      return 0
    fi
    case "$(printf '%s' "$resp" | jq -r '.error // empty')" in
      authorization_pending) : ;;
      slow_down) interval=$((interval + 5)) ;;
      *) die "authorization failed: $resp" ;;
    esac
    sleep "$interval"
  done
  die "timed out waiting for approval"
}

# ── status: что показывает виджет ─────────────────────────────────────────────

cmd_status() {
  local json=0 name="" arg
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
      -h|--help) printf 'usage: opencode-go-auth status [--json] [NAME]\n'; return 0 ;;
      *) name="$arg" ;;
    esac
  done
  [ -z "$name" ] && { name="$(active_name 2>/dev/null || true)"; }
  [ -n "$name" ] || die "no active account (run: opencode-go-auth login --account a)"
  local org access
  org="$(account_field "$name" org_id)"; [ -n "$org" ] || die "no org_id for '$name'"
  access="$(account_field "$name" access_token)"; [ -n "$access" ] || die "no access_token for '$name'"

  local body code
  body="$(curl -sS -w '\n%{http_code}' -H "Authorization: Bearer $access" \
    -H "x-org-id: $org" -H 'Accept: application/json' -H "User-Agent: $UA" "$API")"
  code="${body##*$'\n'}"
  body="${body%$'\n'*}"

  if [ "$code" = "401" ] || [ "$code" = "403" ]; then
    die "HTTP $code — консоль отвергла токен аккаунта '$name'; обнови: opencode-go-auth login --account $name"
  fi
  [ "$code" = "200" ] || die "HTTP $code: $body"

  local expires
  expires="$(account_field "$name" expires_at 2>/dev/null || echo 0)"
  case "$expires" in ''|*[!0-9]*) expires=0 ;; esac

  if [ "$json" = "1" ]; then
    local label; label="$(account_field "$name" label 2>/dev/null || true)"
    printf '%s\n' "$body" | jq -c --arg account "$name" --arg org "$org" --arg label "$label" \
      --argjson expires "$expires" --argjson now "$(date +%s)" '
      { account: $account, label: $label, org_id: $org, expires_at: $expires,
        expires_in: (($expires - $now) | if . > 0 then . else 0 end),
        meters: (.access.meters | with_entries(
          .value |= {
            used:    (.usedMicroCents  | tonumber),
            limit:   (.limitMicroCents | tonumber),
            percent: (if (.limitMicroCents | tonumber) > 0
                      then (((.usedMicroCents | tonumber) * 100 / (.limitMicroCents | tonumber)) | floor)
                      else 0 end),
            resets_at: (.resetsAt // null)
          })) }'
    return 0
  fi

  if [ "$expires" -gt 0 ]; then
    printf 'account %s: token valid for %s more (%s)\n' \
      "$name" "$(humanize $(( expires - $(date +%s) )))" \
      "$(date -d "@$expires" '+%Y-%m-%d %H:%M')" >&2
  fi

  printf '%s\n' "$body" | jq -r '
    .access.meters | to_entries[]
    | "\(.key)\t\((.value.usedMicroCents | tonumber) * 100 / (.value.limitMicroCents | tonumber) | floor)%\tresets=\(.value.resetsAt // "-")"
  '
}

# ── list ──────────────────────────────────────────────────────────────────────

cmd_list() {
  local active
  active="$(active_name 2>/dev/null || true)"
  local names; names="$(account_list)"
  if [ -z "$names" ]; then
    echo "accounts: none (run: opencode-go-auth login --account a)"
    return 0
  fi
  local name org expires clicred clid label
  for name in $names; do
    org="$(account_field "$name" org_id 2>/dev/null || true)"
    expires="$(account_field "$name" expires_at 2>/dev/null || echo 0)"
    label="$(account_field "$name" label 2>/dev/null || true)"
    clicred="$(cat "$(cli_cred_file "$name")" 2>/dev/null || true)"
    clid=""; [ -n "$clicred" ] && clid="cli=$clicred"
    local star=" "; [ "$name" = "$active" ] && star="*"
    printf '%s%s\t%s\torg=%s\tcli_id=%s\texpires=%s\n' \
      "$star" "$name" "${label:-—}" "${org:-?}" "${clid:-—}" \
      "$([ "${expires:-0}" -gt 0 ] 2>/dev/null && date -d "@$expires" '+%Y-%m-%d' || echo 'нет')"
  done
  echo
  echo "активный: ${active:-—}"
}

# ── use / toggle / apply ──────────────────────────────────────────────────────

cmd_use() {
  local name="$1"
  valid_name "$name" || die "invalid account name '$name'"
  [ -f "$(account_file "$name")" ] || die "no credentials for account '$name' — run: opencode-go-auth login --account $name"
  commit_switch "$name"
  [ -f "$SECRETS" ] && sync_secrets nopush || true
  echo "switched to $name"
}

cmd_toggle() {
  local active next=""
  active="$(active_name 2>/dev/null || true)"
  local names; names="$(account_list)"
  [ -n "$names" ] || die "no accounts configured (run: opencode-go-auth login --account a)"
  local name
  for name in $names; do
    if [ -n "$active" ] && [ "$name" != "$active" ]; then next="$name"; break; fi
  done
  [ -n "$next" ] || next="$(printf '%s\n' "$names" | head -1)"
  cmd_use "$next"
}

# Индекс половины месяца — монотонно растёт каждые 1–15 / 16–конец и НЕ зависит
# от текущего состояния. Поэтому rotate идемпотентен: повтор ничего не меняет,
# а две машины сходятся к одному аккаунту. `toggle` же «флипает» и может
# сдвоиться (a→b на ноуте и b→a на десктопе даст рассинхрон).
half_month_index() {
  local y m d
  y="$(date +%Y)"; m="$(date +%-m)"; d="$(date +%-d)"
  printf '%s' "$(( y * 24 + (m - 1) * 2 + (d >= 16 ? 1 : 0) ))"
}

cmd_rotate() {
  local names; names="$(account_list)"
  [ -n "$names" ] || die "no accounts configured (run: opencode-go-auth login --account a)"
  local count idx target
  count="$(printf '%s\n' "$names" | grep -c .)"
  idx="$(( $(half_month_index) % count ))"
  target="$(printf '%s\n' "$names" | sed -n "$(( idx + 1 ))p")"
  [ -n "$target" ] || die "cannot pick an account"
  if [ "$target" = "$(active_name 2>/dev/null || true)" ]; then
    log "rotate: $target уже активен (половина $(date +%Y-%m-%d))"
    printf 'active %s\n' "$target"
    return 0
  fi
  # Не уводим на аккаунт с мёртвым токеном: иначе бар снова покажет ⚠, и
  # виджету придётся чинить это авто-переключением через полминуты.
  local active; active="$(active_name 2>/dev/null || true)"
  if [ -n "$active" ] && [ "$(account_problem "$target")" = "auth" ] \
     && [ -z "$(account_problem "$active")" ]; then
    log "rotate: у «$(account_display "$target")» протух токен — остаюсь на «$(account_display "$active")»"
    printf 'active %s\n' "$active"
    return 0
  fi
  cmd_use "$target"
}

# Уведомить, если токен аккаунта скоро истечёт (по умолчанию за 3 суток).
# Работает и без виджета: дергается systemd-таймером opencode-go-tokencheck.
cmd_check() {
  local threshold="${1:-259200}"
  case "$threshold" in ''|*[!0-9]*) threshold=259200 ;; esac
  local names; names="$(account_list)"
  [ -n "$names" ] || return 0
  local now; now="$(date +%s)"
  local name expires left
  for name in $names; do
    expires="$(account_field "$name" expires_at 2>/dev/null || echo 0)"
    case "$expires" in ''|*[!0-9]*) expires=0 ;; esac
    [ "$expires" -gt 0 ] || continue
    left="$(( expires - now ))"
    if [ "$left" -le 0 ]; then
      notify "OpenCode Go: токен «$(account_display "$name")» истёк" "opencode-go-auth login --account $name"
    elif [ "$left" -lt "$threshold" ]; then
      notify "OpenCode Go: токен «$(account_display "$name")» истекает через $(humanize "$left")" "opencode-go-auth login --account $name"
    fi
  done
  return 0
}

cmd_apply() {
  local name="${1:-}"
  [ -z "$name" ] && { name="$(active_name 2>/dev/null || true)"; }
  [ -n "$name" ] || die "no active account set — run: opencode-go-auth use <name>"
  [ -f "$(account_file "$name")" ] || die "no credentials for account '$name'"
  commit_switch "$name"
  echo "applied $name"
}

# ── label: человеческое имя аккаунта ──────────────────────────────────────────

cmd_label() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: opencode-go-auth label <name> <text|->"
  shift || true
  valid_name "$name" || die "invalid account name '$name'"
  [ -f "$(account_file "$name")" ] || die "no credentials for account '$name'"
  set_label "$name" "$*"
  [ -f "$SECRETS" ] && sync_secrets nopush || true
  refresh_widget
  printf 'label %s: %s\n' "$name" "$(account_field "$name" label 2>/dev/null || echo '—')"
}

# ── auto: переключиться на живой аккаунт ──────────────────────────────────────
#
# Пусто  — аккаунт живой (или сервер/сеть молчат: на сетевой сбое аккаунты не
#         меняем, иначе один моргнувший DNS уводил бы бар на другой аккаунт).
# auth   — токен протух по expires_at или консоль ответила 401/403.
# quota  — выбран лимит (любой из meter'ов в 100%): месяц/неделя кончились.
account_problem() {
  local name="$1" org access expires now body code worst
  now="$(date +%s)"
  expires="$(account_field "$name" expires_at 2>/dev/null || echo 0)"
  case "$expires" in ''|*[!0-9]*) expires=0 ;; esac
  if [ "$expires" -gt 0 ] && [ "$expires" -le "$now" ]; then
    printf 'auth'
    return 0
  fi
  org="$(account_field "$name" org_id)"; access="$(account_field "$name" access_token)"
  [ -n "$org" ] && [ -n "$access" ] || { printf 'auth'; return 0; }

  body="$(curl -sS -m 8 -w '\n%{http_code}' -H "Authorization: Bearer $access" \
    -H "x-org-id: $org" -H 'Accept: application/json' -H "User-Agent: $UA" "$API" 2>/dev/null || true)"
  code="${body##*$'\n'}"
  body="${body%$'\n'*}"
  case "$code" in
    401|403) printf 'auth'; return 0 ;;
    200) : ;;
    *) return 0 ;;  # сеть/5xx — не повод уходить с аккаунта
  esac
  worst="$(printf '%s' "$body" | jq -r '
    [.access.meters[]? | select((.limitMicroCents | tonumber) > 0)
     | ((.usedMicroCents | tonumber) * 100 / (.limitMicroCents | tonumber))]
    | max // 0 | floor' 2>/dev/null || echo 0)"
  [ "${worst:-0}" -ge 100 ] 2>/dev/null && printf 'quota'
  return 0
}

cmd_auto() {
  local names active target reason best="" tried=""
  names="$(account_list)"
  [ -n "$names" ] || die "no accounts configured (run: opencode-go-auth login --account a)"
  active="$(active_name 2>/dev/null || true)"
  if [ -z "$active" ] || [ ! -f "$(account_file "$active")" ]; then
    active="$(printf '%s\n' "$names" | head -1)"
  fi

  reason="$(account_problem "$active")"
  if [ -z "$reason" ]; then
    log "auto: $active в порядке — оставляю"
    printf '%s' "$active"
    return 0
  fi
  log "auto: $active — $reason"

  for target in $names; do
    [ "$target" = "$active" ] && continue
    local r; r="$(account_problem "$target")"
    if [ -z "$r" ]; then best="$target"; break; fi
    tried="$tried $target:$r"
  done

  if [ -z "$best" ]; then
    local hint="" n
    for n in $names; do hint="$hint opencode-go-auth login --account $n;"; done
    notify "OpenCode Go: все аккаунты недоступны" "нужен login:$hint"
    die "некуда переключаться (${active}: ${reason}${tried})"
  fi

  commit_switch "$best"
  [ -f "$SECRETS" ] && sync_secrets nopush || true
  printf '%s\n' "$best"
}

# ── whoami: что консоль знает про токен ───────────────────────────────────────

cmd_whoami() {
  local name="${1:-}"
  [ -z "$name" ] && name="$(active_name 2>/dev/null || true)"
  [ -n "$name" ] || die "usage: opencode-go-auth whoami [NAME]"
  local token org
  token="$(account_field "$name" access_token)"; org="$(account_field "$name" org_id)"
  [ -n "$token" ] || die "no access_token for '$name'"
  printf 'account: %s  label: %s\n' "$name" "$(account_field "$name" label 2>/dev/null || echo '—')"
  local ep body
  for ep in user orgs; do
    body="$(curl -sS -m 10 -H "Authorization: Bearer $token" -H "x-org-id: $org" \
      -H 'Accept: application/json' -H "User-Agent: $UA" "$SERVER/api/$ep" 2>/dev/null || true)"
    printf '/api/%s: %s\n' "$ep" "${body:-—}"
  done
}

cmd_link() {
  local name="$1" cred="$2"
  valid_name "$name" || die "invalid account name '$name'"
  [ -n "$cred" ] || die "usage: opencode-go-auth link <name> <cli_credential_id>"
  local tmp; tmp="$(mktemp "$(cli_cred_file "$name").XXXXXX")"
  printf '%s\n' "$cred" >"$tmp"
  mv -f "$tmp" "$(cli_cred_file "$name")"
  chmod 600 "$(cli_cred_file "$name")"
  echo "linked $name -> opencode credential $cred"
}

cmd_logout() {
  local name="${1:-}"
  [ -z "$name" ] && { name="$(active_name 2>/dev/null || true)"; }
  [ -n "$name" ] || die "no account name given and none active"
  rm -f "$(account_file "$name")" "$(cli_cred_file "$name")"
  log "removed account '$name'"
  local active
  active="$(active_name 2>/dev/null || true)"
  if [ "$active" = "$name" ]; then
    local next
    next="$(account_list | head -1 || true)"
    if [ -n "$next" ]; then
      set_current "$next"
      log "now active: $next"
    else
      rm -f "$CURRENT_FILE" "$CREDS"
      log "no accounts left - removed current pointer"
    fi
  fi
  sync_secrets
}

# ── dispatch ──────────────────────────────────────────────────────────────────

case "${1:-}" in
  login)
    name=""
    [ "${2:-}" = "--account" ] && name="${3:-}" && [ -n "$name" ] || name="${2:-}"
    cmd_login "$name"
    ;;
  use)   cmd_use "${2:?usage: opencode-go-auth use <name>}" ;;
  toggle) cmd_toggle ;;
  rotate) cmd_rotate ;;
  check) cmd_check "${2:-}" ;;
  apply) cmd_apply "${2:-}" ;;
  list)  cmd_list ;;
  label) shift; cmd_label "$@" ;;
  auto)  cmd_auto ;;
  whoami) cmd_whoami "${2:-}" ;;
  link)  cmd_link "${2:-}" "${3:-}" ;;
  status) shift; cmd_status "$@" ;;
  sync)  sync_secrets ;;
  logout) cmd_logout "${2:-}" ;;
  *)
    sed -n '3,/^set -euo pipefail/p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac