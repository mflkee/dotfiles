#!/usr/bin/env bash
# tmux-import-buffer: restore tmux sessions from the snapshot pushed to ~/buffer
# by another machine. Restarts the tmux server cleanly.
set -euo pipefail

SRC="${HOME}/buffer/tmux-session.txt"
RESURRECT_DIR="${HOME}/.local/share/tmux/resurrect"

if [[ ! -f "$SRC" ]]; then
  printf 'Snapshot not found: %s (wait for Syncthing to sync it)\n' "$SRC" >&2
  exit 1
fi

mkdir -p "$RESURRECT_DIR"

# Stop any running server so restore starts clean (avoids duplicate sessions)
tmux kill-server 2>/dev/null || true
sleep 1

# Point resurrect's "last" at the synced snapshot and restore
ln -sfn "$SRC" "$RESURRECT_DIR/last"
"${HOME}/.tmux/plugins/tmux-resurrect/scripts/restore.sh"

printf 'Restored tmux sessions from %s\n' "$SRC"
