#!/usr/bin/env bash
# tmux-tokyo-night-theme-apply: Apply Noctalia theme to tokyo-night-tmux and run TPM
set -euo pipefail

TPM_DIR="${HOME}/.tmux/plugins/tpm"
TOKYO_DIR="${HOME}/.tmux/plugins/tokyo-night-tmux"
THEMES_SH="${TOKYO_DIR}/src/themes.sh"
COLORS_JSON="${HOME}/.config/noctalia/colors.json"

# Generate complete themes.sh from Noctalia colors
generate_themes() {
    [ -f "$COLORS_JSON" ] || return 0
    python3 << 'PYEOF'
import json, os

colors_path = os.path.expanduser("~/.config/noctalia/colors.json")
with open(colors_path) as f:
    c = json.load(f)

# Noctalia Material3 -> Tokyo Night theme mapping
mapping = [
    ("background", c.get("mSurface", "#1a1b26")),
    ("foreground", c.get("mOnSurface", "#c0caf5")),
    ("black", c.get("mSurface", "#1a1b26")),
    ("blue", c.get("mPrimary", "#7aa2f7")),
    ("cyan", c.get("mSecondary", "#bb9af7")),
    ("green", c.get("mTertiary", "#9ece6a")),
    ("magenta", c.get("mSecondary", "#bb9af7")),
    ("red", c.get("mError", "#f7768e")),
    ("white", c.get("mOnSurface", "#c0caf5")),
    ("yellow", c.get("mPrimary", "#7aa2f7")),
    ("bblack", c.get("mSurfaceVariant", "#24283b")),
    ("bblue", c.get("mPrimary", "#7aa2f7")),
    ("bcyan", c.get("mSecondary", "#bb9af7")),
    ("bgreen", c.get("mTertiary", "#9ece6a")),
    ("bmagenta", c.get("mSecondary", "#bb9af7")),
    ("bred", c.get("mError", "#f7768e")),
    ("bwhite", c.get("mOnSurfaceVariant", "#9aa5ce")),
    ("byellow", c.get("mPrimary", "#7aa2f7")),
    ("ghgreen", "#3fb950"),
    ("ghmagenta", "#A371F7"),
    ("ghred", "#d73a4a"),
    ("ghyellow", "#d29922"),
]

lines = ['#!/usr/bin/env bash', '# Auto-generated from Noctalia colors by tmux-tokyo-night-theme-apply']
lines.append('')
lines.append('TRANSPARENT_THEME="$(tmux show-option -gv @tokyo-night-tmux_transparent 2>/dev/null)"')
lines.append('')
lines.append('declare -A THEME=(')
for k, v in mapping:
    lines.append(f'    ["{k}"]="{v}"')
lines.append(')')
lines.append('')

# Transparent theme override
lines.append('# Override background with "default" if transparent theme is enabled')
lines.append('if [ "${TRANSPARENT_THEME}" == 1 ]; then')
lines.append('  THEME["background"]="default"')
lines.append('fi')
lines.append('')
lines.append('THEME["ghgreen"]="#3fb950"')
lines.append('THEME["ghmagenta"]="#A371F7"')
lines.append('THEME["ghred"]="#d73a4a"')
lines.append('THEME["ghyellow"]="#d29922"')
lines.append('')
lines.append('RESET="#[fg=${THEME[foreground]},bg=${THEME[background]},nobold,noitalics,nounderscore,nodim]"')
lines.append('')

os.makedirs(os.path.dirname(os.path.expanduser("~/.tmux/plugins/tokyo-night-tmux/src/themes.sh")), exist_ok=True)
with open(os.path.expanduser("~/.tmux/plugins/tokyo-night-tmux/src/themes.sh"), "w") as f:
    f.write("\n".join(lines))
print("Generated themes.sh from Noctalia colors")
PYEOF
}

# Ensure theme options are set
tmux set -g @tokyo-night-tmux_theme storm 2>/dev/null || true
tmux set -g @tokyo-night-tmux_transparent 0 2>/dev/null || true

# Main
generate_themes

# Run TPM if available
if [ -f "${TPM_DIR}/tpm" ]; then
    "${TPM_DIR}/tpm"
fi
