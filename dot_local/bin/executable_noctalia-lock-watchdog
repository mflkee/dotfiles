#!/bin/sh
# noctalia-lock-watchdog — страховка от «залипшего» локскрина.
#
# ИСТОРИЯ (обход): стоял noctalia r4541 (июль), а конфиг локскрина приехал с
# десктопа (r5310) со схемой lockscreen_widgets v2. Эта сборка её не понимает:
# сессия блокировалась (niri: "locking session"), но локскрин не рисовался —
# пустой экран без поля ввода, разблокировка невозможна. Обход: перезапуск
# оболочки рвёт ext-session-lock, niri освобождает сессию.
#
# v2 (2026-10-02) — обход выключен по сути и переписан:
#   1. Нормальный лок больше НЕ считается зависанием. Старая версия брала
#      «лок старше 120 с» как признак зависания и перезапускала оболочку
#      каждые 30 с, пока сессия заблокирована. На Noctalia v5.2.1 локскрин
#      рисуется нормально, но этот цикл рвал ext-session-lock, после чего
#      niri не смог перезапустить сессию («Failed to open session», os error
#      38) — пользователь получал пустой («коричневый») экран и уходил в
#      ребут. Наблюдалось 2026-10-02 12:40–12:43.
#   2. Зависание = сессия заблокирована, а клиента лока (noctalia) НЕТ:
#      рисовать локскрин некому. Если noctalia жива и сама рапортует
#      locked:true — всё в порядке, ждём пользователя.
#   3. Спасение сначала через `loginctl unlock-session` (снимает secure-состояние
#      без перезапуска оболочки), и только если не вышло — рестарт оболочки.
#
# Настройка (в noctalia-lock-watchdog.service):
#   LOCK_WATCHDOG_TIMEOUT=120     сколько секунд ждать при отсутствии noctalia
#   LOCK_WATCHDOG_MIN_INTERVAL=30  пауза перед повторной попыткой
#
# Состояние: ${XDG_CACHE_HOME:-~/.cache}/noctalia-lock-watchdog/locked-since
set -eu

TIMEOUT="${LOCK_WATCHDOG_TIMEOUT:-120}"
MIN_INTERVAL="${LOCK_WATCHDOG_MIN_INTERVAL:-30}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/noctalia-lock-watchdog"
STATE_FILE="$STATE_DIR/locked-since"

log() {
    printf '%s [lock-watchdog] %s\n' "$(date -Is)" "$*" >&2
}

# Жив ли noctalia (клиент лока / оболочка). Если отвечает — рисует локскрин.
noctalia_alive() {
    noctalia msg status >/dev/null 2>&1
}

# Ищем ID графической сессии: сначала из окружения, иначе последняя активная.
session_id() {
    if [ -n "${XDG_SESSION_ID:-}" ]; then
        printf '%s\n' "$XDG_SESSION_ID"
        return 0
    fi
    loginctl list-sessions --no-legend 2>/dev/null |
        awk -v u="$USER" '$3 == u { print $1 }' | tail -1
}

# Заблокирована ли сессия: сперва сам noctalia, на случай его смерти — logind.
is_locked() {
    if out=$(noctalia msg status 2>/dev/null); then
        case "$out" in
            *'"locked": true'*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    sid=$(session_id)
    [ -n "$sid" ] || return 1
    [ "$(loginctl show-session "$sid" -p LockHint --value 2>/dev/null)" = "yes" ]
}

now=$(date +%s)

if ! is_locked; then
    rm -f "$STATE_FILE"
    exit 0
fi

# ── ГЛАВНОЕ ПРАВИЛО v2 ──────────────────────────────────────────────────────
# Сессия заблокирована, но noctalia жива и сама её заблокировала — это обычный
# лок, а не зависание. Ничего не трогаем (иначе пользователь возвращается к
# разблокированному компу, а в худшем случае — к сломанному niri).
if noctalia_alive; then
    rm -f "$STATE_FILE"
    exit 0
fi

# Дальше — только случай «сессия заблокирована, рисовать некому».
if [ ! -f "$STATE_FILE" ]; then
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$now" >"$STATE_FILE"
    log "сессия заблокирована, noctalia не запущена — жду до ${TIMEOUT}s"
    exit 0
fi

since=$(cat "$STATE_FILE" 2>/dev/null || printf '%s' "$now")
case "$since" in
    '' | *[!0-9]*) since=$now ;;
esac
age=$((now - since))

if [ "$age" -lt "$TIMEOUT" ]; then
    exit 0
fi

# ── Спасение: сперва снять блокировку сессии, оболочку трогать только как откат ──
sid="$(session_id || true)"
if [ -n "$sid" ] && loginctl unlock-session "$sid" >/dev/null 2>&1; then
    log "локскрин не отрисовался (noctalia нет ${age}s) — сессию $sid разблокировал loginctl"
    rm -f "$STATE_FILE"
    exit 0
fi

if systemctl --user restart noctalia-shell.service; then
    log "локскрин не отрисовался, loginctl не помог — перезапустил noctalia-shell"
else
    log "не удалось снять блокировку: ни loginctl, ни рестарт оболочки не помогли"
fi

# Пауза перед следующей попыткой, чтобы не дёргать рестарт каждые 30 секунд.
printf '%s\n' "$((now + MIN_INTERVAL))" >"$STATE_FILE"
