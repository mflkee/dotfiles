#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="$HOME/.config/vpn-manager"
SELECTED_FILE="$STATE_DIR/selected"
WAYBAR_SIGNAL=5
MENU_PROMPT="${VPN_MENU_PROMPT:-VPN}"
CONF_DIR_PRIMARY="${VPN_CONF_DIR_PRIMARY:-$HOME/.config/amneziawg/full}"
CONF_DIR_SECONDARY="${VPN_CONF_DIR_SECONDARY:-$HOME/.config/scripts/vpn-split-codex}"
AWG_QUICK_BIN="${AWG_QUICK_BIN:-/usr/bin/awg-quick}"

CONF_DIRS=()
if [[ -n "${VPN_CONF_DIR:-}" ]]; then
  CONF_DIRS+=("$VPN_CONF_DIR")
else
  CONF_DIRS+=("$CONF_DIR_PRIMARY" "$CONF_DIR_SECONDARY")
fi

mkdir -p "$STATE_DIR"

menu_cmd() {
  if [[ -n "${VPN_MENU_CMD:-}" ]]; then
    read -r -a MENU_CMD <<<"$VPN_MENU_CMD"
    return 0
  fi
  if command -v dmenu >/dev/null 2>&1; then
    MENU_CMD=(dmenu -i -p "$MENU_PROMPT")
    return 0
  fi
  if command -v rofi >/dev/null 2>&1; then
    MENU_CMD=(rofi -dmenu -i -p "$MENU_PROMPT")
    return 0
  fi
  echo "Missing launcher: dmenu or rofi (or set VPN_MENU_CMD)" >&2
  return 1
}


normalize_name() {
  local name="$1"
  name="${name%.conf}"
  printf '%s\n' "$name"
}

list_configs() {
  shopt -s nullglob
  local dir f name
  declare -A seen=()
  for dir in "${CONF_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.conf; do
      name="$(basename "${f%.conf}")"
      [[ -n "${seen[$name]:-}" ]] && continue
      seen[$name]=1
      printf '%s\n' "$name"
    done
  done
}

conf_dir_for() {
  local name="$1"
  local dir
  for dir in "${CONF_DIRS[@]}"; do
    if [[ -f "$dir/$name.conf" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
  return 1
}

name_exists() {
  local name
  name="$(normalize_name "$1")"
  conf_dir_for "$name" >/dev/null 2>&1
}

default_name() {
  list_configs | head -n1
}

current_name() {
  local name=""
  if [[ -f "$SELECTED_FILE" ]]; then
    name=$(<"$SELECTED_FILE")
  fi
  if [[ -z "$name" ]] || ! name_exists "$name"; then
    name=$(default_name)
    if [[ -z "$name" ]]; then
      return 1
    fi
    printf '%s\n' "$name" > "$SELECTED_FILE"
  fi
  printf '%s\n' "$name"
}

refresh_waybar() {
  pkill -RTMIN+$WAYBAR_SIGNAL waybar 2>/dev/null || true
}

ensure_askpass() {
  local askpass="$STATE_DIR/askpass.sh"
  if ! command -v rofi >/dev/null 2>&1 && \
     ! command -v dmenu >/dev/null 2>&1 && \
     ! command -v zenity >/dev/null 2>&1 && \
     ! command -v kdialog >/dev/null 2>&1; then
    return 1
  fi
  if [[ ! -x "$askpass" ]]; then
    cat > "$askpass" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if command -v rofi >/dev/null 2>&1; then
  rofi -dmenu -password -p "sudo"
elif command -v dmenu >/dev/null 2>&1; then
  dmenu -P -p "sudo"
elif command -v zenity >/dev/null 2>&1; then
  zenity --password
elif command -v kdialog >/dev/null 2>&1; then
  kdialog --password "sudo"
else
  echo "No askpass UI found" >&2
  exit 1
fi
EOF
    chmod 700 "$askpass"
  fi
  export SUDO_ASKPASS="$askpass"
  return 0
}

build_priv_cmd() {
  if [[ -n "${VPN_PRIV_CMD:-}" ]]; then
    read -r -a PRIV_CMD <<<"$VPN_PRIV_CMD"
    return 0
  fi

  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    PRIV_CMD=(sudo)
    return 0
  fi

  if command -v pkexec >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    PRIV_CMD=(pkexec)
    return 0
  fi

  if command -v sudo >/dev/null 2>&1; then
    if ensure_askpass; then
      PRIV_CMD=(sudo -A)
      return 0
    fi
  fi

  if command -v pkexec >/dev/null 2>&1; then
    PRIV_CMD=(pkexec)
    return 0
  fi

  return 1
}

run_awg_quick() {
  local action="$1"
  local conf="$2"
  local -a PRIV_CMD
  if ! build_priv_cmd; then
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "VPN" "Need privileges to run awg-quick. Install sudoers in /etc/sudoers.d/awg-quick or set VPN_PRIV_CMD." >/dev/null 2>&1 || true
    fi
    echo "Need privileges to run awg-quick. Install sudoers in /etc/sudoers.d/awg-quick or set VPN_PRIV_CMD." >&2
    return 1
  fi
  "${PRIV_CMD[@]}" "$AWG_QUICK_BIN" "$action" "$conf"
}

active_iface() {
  local name
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    if ip link show "$name" >/dev/null 2>&1; then
      printf '%s\n' "$name"
      return 0
    fi
  done < <(list_configs)
}

conf_path() {
  local name
  name="$(normalize_name "$1")"
  local dir
  dir="$(conf_dir_for "$name" || true)"
  if [[ -z "$dir" ]]; then
    dir="$CONF_DIR_PRIMARY"
  fi
  printf '%s/%s.conf\n' "$dir" "$name"
}

down_iface() {
  local iface="$1"
  local conf
  conf="$(conf_path "$iface")"
  if [[ ! -f "$conf" ]]; then
    echo "Config not found: $conf" >&2
    return 1
  fi
  run_awg_quick down "$conf" || true
}

connect() {
  local name="${1:-}"
  if [[ -n "$name" ]]; then
    name="$(normalize_name "$name")"
  else
    name=$(current_name)
  fi
  if [[ -z "$name" ]]; then
    echo "No VPN configuration selected" >&2
    exit 1
  fi
  if ! name_exists "$name"; then
    echo "Config not found: $(conf_path "$name")" >&2
    exit 1
  fi
  local active
  active=$(active_iface || true)
  if [[ -n "${active:-}" && "$active" != "$name" ]]; then
    down_iface "$active"
  fi
  run_awg_quick up "$(conf_path "$name")"
  refresh_waybar
}

disconnect() {
  local active
  active=$(active_iface || true)
  if [[ -n "${active:-}" ]]; then
    down_iface "$active"
  fi
  refresh_waybar
}

toggle() {
  if [[ -n "$(active_iface || true)" ]]; then
    disconnect
  else
    connect
  fi
}

status() {
  local active selected
  active=$(active_iface || true)
  selected=$(current_name 2>/dev/null || true)
  if [[ -n "${active:-}" ]]; then
    printf 'connected\t%s\t%s\n' "$active" "$selected"
  else
    printf 'disconnected\t\t%s\n' "$selected"
  fi
}

waybar() {
  local state active selected
  IFS=$'\t' read -r state active selected < <(status)
  local icon class tooltip
  if [[ "$state" == "connected" ]]; then
    icon=""
    class="connected"
    tooltip="VPN connected: $active"
  else
    icon=""
    class="disconnected"
    if [[ -n "${selected:-}" ]]; then
      tooltip="VPN disconnected (selected: $selected)"
    else
      tooltip="VPN disconnected"
    fi
  fi
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$icon" "$tooltip" "$class"
}

choose_name() {
  menu_cmd || return 1
  local selected
  selected=$(current_name 2>/dev/null || true)
  local menu=""
  local name
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    if [[ "$name" == "$selected" ]]; then
      menu+="* $name\n"
    else
      menu+="$name\n"
    fi
  done < <(list_configs)
  local choice
  choice=$(printf '%b' "$menu" | "${MENU_CMD[@]}") || return 1
  if [[ "$choice" == \** ]]; then
    choice=${choice#* }
  fi
  if [[ -z "$choice" ]]; then
    return 0
  fi
  printf '%s\n' "$choice"
}

select_config() {
  local name
  name=$(choose_name) || return 1
  if [[ -z "$name" ]]; then
    return 0
  fi
  printf '%s\n' "$name" > "$SELECTED_FILE"
  refresh_waybar
}

menu_connect() {
  local name
  name=$(choose_name) || return 1
  if [[ -z "$name" ]]; then
    return 0
  fi
  printf '%s\n' "$name" > "$SELECTED_FILE"
  connect "$name"
}

case "${1:-}" in
  connect)
    connect "${2:-}"
    ;;
  disconnect)
    disconnect
    ;;
  toggle)
    toggle
    ;;
  status)
    status
    ;;
  waybar)
    waybar
    ;;
  select)
    select_config
    ;;
  menu)
    menu_connect
    ;;
  list)
    list_configs
    ;;
  current)
    current_name
    ;;
  *)
    echo "Usage: vpn-manager {connect|disconnect|toggle|status|waybar|select|menu|list|current} [name]" >&2
    exit 1
    ;;
esac
