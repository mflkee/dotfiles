#!/bin/sh
set -e
# trigger: {{ include "dot_config/noctalia/settings.json" | sha256sum }}

SETTINGS="$HOME/.config/noctalia/settings.json"
[ -f "$SETTINGS" ] || exit 0

HOSTNAME=$(hostname)

case "$HOSTNAME" in
    archlinux-notebook*)
        command -v jq >/dev/null 2>&1 || exit 0
        jq '
            .wallpaper.wallhavenQuery = "berserk" |
            .network.networkPanelView = "ethernet" |
            .network.bluetoothAutoConnect = false |
            .location.name = "" |
            .bar.widgets.right = [.bar.widgets.right[] | select(.id != "plugin:arch-updater")]
        ' "$SETTINGS" > "${SETTINGS}.tmp" && mv "${SETTINGS}.tmp" "$SETTINGS"
        ;;
esac
