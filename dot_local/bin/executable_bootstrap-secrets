#!/usr/bin/env bash
set -euo pipefail

SRC_DIR="${1:-$HOME/Sync/bootstrap}"
SSH_SRC="$SRC_DIR/ssh"
GPG_SRC="$SRC_DIR/gpg"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [[ -d "$SSH_SRC" ]]; then
  while IFS= read -r -d '' file; do
    target="$HOME/.ssh/$(basename "$file")"
    install -m 600 "$file" "$target"
    case "$target" in
      *.pub)
        chmod 644 "$target"
        ;;
    esac
  done < <(find "$SSH_SRC" -maxdepth 1 -type f -print0)
fi

if [[ -d "$GPG_SRC" ]]; then
  while IFS= read -r -d '' file; do
    case "$file" in
      */ownertrust.txt)
        ;;
      *)
        gpg --import "$file"
        ;;
    esac
  done < <(find "$GPG_SRC" -maxdepth 1 -type f \( -name '*.asc' -o -name '*.gpg' -o -name '*.pgp' \) -print0)

  if [[ -f "$GPG_SRC/ownertrust.txt" ]]; then
    gpg --import-ownertrust < "$GPG_SRC/ownertrust.txt"
  fi
fi

if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "${SSH_AUTH_SOCK:-}" ]]; then
  for key in "$HOME"/.ssh/id_*; do
    [[ -f "$key" ]] || continue
    [[ "$key" == *.pub ]] && continue
    ssh-add "$key" >/dev/null 2>&1 || true
  done
fi

printf 'Imported bootstrap secrets from %s\n' "$SRC_DIR"
