#!/usr/bin/env bash
set -euo pipefail

SRC_DIR="${1:-$HOME/.config/zen}"
DST_DIR="${2:-$HOME/buffer/zen}"
BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/zen-profile-backups"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
ZEN_PATTERN='/opt/zen-browser-bin/zen-bin|/usr/sbin/zen-browser|zen-browser|zen-bin'
RESTART_ZEN=0

is_zen_running() {
  local pid stat
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    stat="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ -n "$stat" ]] || continue
    case "$stat" in
      Z*|X*)
        continue
        ;;
      *)
        return 0
        ;;
    esac
  done < <(pgrep -f "$ZEN_PATTERN" 2>/dev/null || true)
  return 1
}

remove_locks() {
  local root="$1"
  find "$root" \( -name 'lock' -o -name '.parentlock' -o -name 'parent.lock' \) -delete 2>/dev/null || true
}

stop_zen() {
  local _i

  pkill -TERM -f "$ZEN_PATTERN" 2>/dev/null || true

  for _i in {1..50}; do
    if ! is_zen_running; then
      return 0
    fi
    sleep 0.2
  done

  pkill -KILL -f "$ZEN_PATTERN" 2>/dev/null || true

  for _i in {1..25}; do
    if ! is_zen_running; then
      return 0
    fi
    sleep 0.2
  done

  printf 'Failed to stop Zen.\n' >&2
  return 1
}

start_zen() {
  nohup zen-browser >/dev/null 2>&1 &
}

cleanup() {
  local status=$?
  trap - EXIT

  if [[ "$RESTART_ZEN" -eq 1 ]]; then
    if start_zen; then
      printf 'Restarted Zen.\n'
    else
      printf 'Failed to restart Zen.\n' >&2
      if [[ "$status" -eq 0 ]]; then
        status=1
      fi
    fi
  fi

  exit "$status"
}

if [[ ! -d "$SRC_DIR" ]]; then
  printf 'Source Zen profile dir not found: %s\n' "$SRC_DIR" >&2
  exit 1
fi

if is_zen_running; then
  RESTART_ZEN=1
  trap cleanup EXIT
  stop_zen
fi

mkdir -p "$BACKUP_ROOT"

if [[ -e "$DST_DIR" ]]; then
  mkdir -p "$BACKUP_ROOT"
  cp -a "$DST_DIR" "$BACKUP_ROOT/buffer-$TIMESTAMP"
fi

mkdir -p "$DST_DIR"
rsync -a --delete \
  --exclude 'lock' \
  --exclude '.parentlock' \
  --exclude 'parent.lock' \
  "$SRC_DIR"/ "$DST_DIR"/

remove_locks "$DST_DIR"

printf 'Exported Zen profile to %s\n' "$DST_DIR"
printf 'Backup saved to %s\n' "$BACKUP_ROOT/buffer-$TIMESTAMP"
