#!/bin/sh

set -eu

WIDTH="${CODEX_TMUX_WIDTH:-25%}"
SCRATCH_SESSION="${CODEX_TMUX_SCRATCH_SESSION:-__codex_scratch}"
CODEX_COMMAND="${CODEX_TMUX_COMMAND:-exec codex}"
PANE_OPTION='@codex_pane'
HOST_OPTION='@codex_host_pane'

tmux_bin() {
  tmux "$@"
}

current_window() {
  tmux_bin display-message -p -F '#{window_id}'
}

current_pane() {
  tmux_bin display-message -p -F '#{pane_id}'
}

current_path() {
  tmux_bin display-message -p -F '#{pane_current_path}'
}

window_option() {
  tmux_bin show-options -wqv -t "$1" "$2" 2>/dev/null || true
}

set_window_option() {
  tmux_bin set-option -wq -t "$1" "$2" "$3"
}

clear_window_option() {
  tmux_bin set-option -wu -t "$1" "$2" 2>/dev/null || true
}

pane_exists() {
  [ -n "${1:-}" ] && tmux_bin display-message -p -t "$1" -F '#{pane_id}' >/dev/null 2>&1
}

pane_window() {
  tmux_bin display-message -p -t "$1" -F '#{window_id}' 2>/dev/null || true
}

ensure_scratch_session() {
  tmux_bin has-session -t "$SCRATCH_SESSION" 2>/dev/null || tmux_bin new-session -d -s "$SCRATCH_SESSION"
}

window_id="$(current_window)"
active_pane="$(current_pane)"
workdir="$(current_path)"
codex_pane="$(window_option "$window_id" "$PANE_OPTION")"
host_pane="$(window_option "$window_id" "$HOST_OPTION")"

if ! pane_exists "$codex_pane"; then
  clear_window_option "$window_id" "$PANE_OPTION"
  codex_pane=''
fi

if ! pane_exists "$host_pane"; then
  clear_window_option "$window_id" "$HOST_OPTION"
  host_pane=''
fi

if [ -z "$codex_pane" ]; then
  new_pane="$(tmux_bin split-window -h -l "$WIDTH" -c "$workdir" -P -F '#{pane_id}' "$CODEX_COMMAND")"
  set_window_option "$window_id" "$PANE_OPTION" "$new_pane"
  set_window_option "$window_id" "$HOST_OPTION" "$active_pane"
  tmux_bin select-pane -t "$new_pane" -T 'Codex' >/dev/null 2>&1 || true
  tmux_bin select-pane -t "$new_pane"
  exit 0
fi

if [ "$(pane_window "$codex_pane")" = "$window_id" ]; then
  ensure_scratch_session
  tmux_bin break-pane -d -s "$codex_pane" -t "${SCRATCH_SESSION}:"
  exit 0
fi

target_pane="$active_pane"

if pane_exists "$host_pane" && [ "$(pane_window "$host_pane")" = "$window_id" ]; then
  target_pane="$host_pane"
fi

tmux_bin join-pane -h -l "$WIDTH" -s "$codex_pane" -t "$target_pane"
set_window_option "$window_id" "$HOST_OPTION" "$target_pane"
tmux_bin select-pane -t "$codex_pane" -T 'Codex' >/dev/null 2>&1 || true
tmux_bin select-pane -t "$codex_pane"
