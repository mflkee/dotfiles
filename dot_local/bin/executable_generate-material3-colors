#!/usr/bin/env bash
# generate-material3-colors: Generate Noctalia Material3 palette from community theme
# Reads theme-profile.toml, finds corresponding ghostty theme, generates colors.json
set -euo pipefail

THEME_PROFILE="${HOME}/.config/noctalia/theme-profile.toml"
COLORS_JSON="${HOME}/.config/noctalia/colors.json"
GHOSTTY_THEMES="/usr/share/ghostty/themes"

[ -f "$THEME_PROFILE" ] || { echo "theme-profile.toml not found"; exit 1; }

python3 << PYEOF
import os, sys, json, colorsys

THEME_PROFILE = os.path.expanduser("~/.config/noctalia/theme-profile.toml")
COLORS_JSON = os.path.expanduser("~/.config/noctalia/colors.json")
GHOSTTY_THEMES = "/usr/share/ghostty/themes"

# Read theme profile
try:
    import tomllib
    with open(THEME_PROFILE, "rb") as f:
        profile = tomllib.load(f)
except:
    sys.exit(0)

palette_name = profile.get("theme", {}).get("community_palette", "")
if not palette_name:
    sys.exit(0)

# Find ghostty theme file for this palette
theme_file = os.path.join(GHOSTTY_THEMES, palette_name)
if not os.path.exists(theme_file):
    # Try case-insensitive
    for f in os.listdir(GHOSTTY_THEMES):
        if f.lower() == palette_name.lower():
            theme_file = os.path.join(GHOSTTY_THEMES, f)
            break
    else:
        # Fallback: use seed color from palette name hash
        seed = hash(palette_name)
        bg = f"#{abs(seed % 0x1000000):06x}"
        fg = "#ffffff"

if os.path.exists(theme_file):
    # Parse ghostty format: key = value
    theme = {}
    with open(theme_file) as f:
        for line in f:
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                theme[k.strip()] = v.strip()

    bg = theme.get("background", "#222222")
    fg = theme.get("foreground", "#c2c2b0")
    palette = [theme.get(str(i), f"#{i:x}{i:x}{i:x}") for i in range(16)]
    # Use palette[5] as seed accent (or palette[1] if 5 is same as bg)
    seed = palette[5] if palette[5].lower() != bg.lower() else palette[1]
else:
    # Default Miasma
    palette = ["#000000","#685742","#5f875f","#b36d43",
               "#78824b","#bb7744","#c9a554","#d7c483",
               "#666666","#685742","#5f875f","#b36d43",
               "#78824b","#bb7744","#c9a554","#d7c483"]
    seed = palette[5]
    bg = "#222222"
    fg = "#c2c2b0"

def hex_to_hsl(h):
    r, g, b = int(h[1:3],16)/255, int(h[3:5],16)/255, int(h[5:7],16)/255
    mx, mn = max(r,g,b), min(r,g,b)
    l = (mx + mn) / 2
    if mx == mn:
        return (0, 0, l)
    d = mx - mn
    s = d / (2 - mx - mn) if l > 0.5 else d / (mx + mn)
    if mx == r:
        h = (g - b) / d + (6 if b > g else 0)
    elif mx == g:
        h = (b - r) / d + 2
    else:
        h = (r - g) / d + 4
    h /= 6
    return (h, s, l)

def hsl_to_hex(h, s, l):
    r,g,b = [max(0, min(255, int(c*255))) for c in colorsys.hls_to_rgb(h % 1, l, s)]
    return f"#{r:02x}{g:02x}{b:02x}"

def blend(c1, c2, t):
    r1,g1,b1 = int(c1[1:3],16),int(c1[3:5],16),int(c1[5:7],16)
    r2,g2,b2 = int(c2[1:3],16),int(c2[3:5],16),int(c2[5:7],16)
    return f"#{int(r1*(1-t)+r2*t):02x}{int(g1*(1-t)+g2*t):02x}{int(b1*(1-t)+b2*t):02x}"

h, s, l = hex_to_hsl(seed)
l_ok = l > 0.5

colors = {
    "mSurface": bg,
    "mOnSurface": fg,
    "mSurfaceVariant": blend(bg, fg, 0.15),
    "mOnSurfaceVariant": blend(fg, bg, 0.25),
    "mPrimary": seed,
    "mOnPrimary": "#16161e" if l_ok else "#f0f0f0",
    "mSecondary": palette[3],
    "mOnSecondary": "#16161e",
    "mTertiary": palette[2],
    "mOnTertiary": "#16161e",
    "mError": "#c74e4e",
    "mOnError": "#16161e",
    "mOutline": blend(bg, fg, 0.35),
    "mShadow": "#000000",
    "mHover": palette[14],
    "mOnHover": "#16161e",
}

with open(COLORS_JSON, "w") as f:
    json.dump(colors, f, indent=4)
print(f"Generated {COLORS_JSON} from {palette_name}")
PYEOF
